    <!-- npc_f5_xml · 场景 140 -->
    <NPCFun sceneID="140" label="先知lulu" icon="-1" close="false">
            <Click event="onRunScript">
              <Script label="default" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">你果然是个了不起的小洛克，下面让我来帮你重铸法杖吧。</Dialog>
                  <Button label="好的。" nextID="-1" close="true">
                    <Goto value="index_2205001"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205001" type="asWindow" src="task/190/190_4" winPos="0|0" name="重铸法杖">
                <Default>
                  <Goto value="index_2205002"/>
                </Default>
              </Script>
              
              <Script label="index_2205002" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">现在，你可以开始踏上自己的旅程了，魔法先锋队在各自的异度空间沉睡着，异度空间就在神殿的各个大门后。</Dialog>
                  <Button label="哇，那我现在就去。" nextID="-1" close="false">
                    <Goto value="index_2205003"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205003" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">不要着急，我的孩子，以我现在的力量还不足以开启所有的大门，而且欲速则不达，以后的每个月，我都会为你开启一道空间之门。</Dialog>
                  <Dialog npcID="220500" npcName="先知lulu">我还需要提醒你，虽然你已经得到了法杖，但异度空间里仍旧是非常危险的，没有自己的lulu陪伴，是无法进入异度空间的。</Dialog>
                  <Button label="我知道了。" nextID="-1" close="false">
                    <Goto value="index_2205004"/>
                  </Button>
                </Page>
              </Script>
              
               <Script label="index_2205004" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">现在，神殿的第一道门已经打开了，开始你的历险吧，我会一直在这里注视着你的。</Dialog>
                  <Button label="我会成为一名勇敢的魔法师的！" nextID="-1" close="true">
                    <Goto value="index_2205005"/>
                  </Button>
                </Page>
              </Script>
              
              <Click label="index_2205005" event="onTaskCall2" params="2|190"/>
            </Click>
          </NPCFun>
