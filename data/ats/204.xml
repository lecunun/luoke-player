<Story id="204" label="魔法先锋队">
  <Task id="190" label="先锋队的号角">
    <!-- npc_f0_xml · 场景 140 -->
    <NPCFun sceneID="140" label="你是谁?" icon="-1" close="false">
            <Click event="onRunScript">
              <Script label="default" type="dialog">
                <Page id="0">
                   <Dialog npcID="220500" npcName="先知lulu"><![CDATA[{name}]]>，我听过你的名字，格里芬说过，你是个不错的小洛克。
                  </Dialog>
                  <Button label="我以前好像没有见过你。" nextID="-1" close="false">
                    <Goto value="index_1001001"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_1001001" type="dialog">
                <Page id="0">
                   <Dialog npcID="220500" npcName="先知lulu">我的名字叫做先知lulu，曾是一位伟大魔法师身边的lulu，以前我一直低调的生活在王国中，但这段时间王国与黑衣人之前的纷争让我很担忧，所以我决定站出来，用我主人的力量帮助王国。</Dialog>
                  <Button label="哇，听上去好厉害的样子。" nextID="-1" close="true">
                    <Goto value="index_1001002"/>
                  </Button>
                </Page>
              </Script>
         
              <Click label="index_1001002" event="onTaskCall2" params="1|190"/>
            </Click>
          </NPCFun>
    <!-- npc_f1_xml · 场景 140 -->
    <NPCFun sceneID="140" label="先知lulu" icon="0" close="false">
            <Click event="onRunScript">
              <Script label="default" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">嗯，首先，你愿意听一位老人讲讲他的故事吗？</Dialog>
                  <Button label="故事？好啊好啊。" nextID="-1" close="false">
                    <Goto value="index_2205002"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205002" type="dialog">
                <Page id="0">
                   <Dialog npcID="220500" npcName="先知lulu">你看，广场那边有一卷记载着我的故事的魔法卷轴，你点击它就可以知道我的故事了。</Dialog>
                  <Button label="好的。" nextID="-1" close="true">
                    <Goto value="index_2205003"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205003" type="asWindow" src="task/190/190_0" winPos="0|0" name="">
                <Default>
                  <Goto value="index_2205004"/>
                </Default>
              </Script>
              <Script label="index_2205004" type="asWindow" src="task/190/190_1" winPos="0|0" name="">
                <Default>
                  <Goto value="index_2205005"/>
                </Default>
              </Script>
              <Script label="index_2205005" type="asWindow" src="task/190/190_2" winPos="0|0" name="">
                <Default>
                  <Goto value="index_2205006"/>
                </Default>
              </Script>
              <Script label="index_2205006" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">现在你知道我的故事了吧。</Dialog>
                  <Button label="哇，你的主人都好厉害啊。" nextID="-1" close="false">
                    <Goto value="index_2205007"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205007" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">那是当然啦，现在，<![CDATA[{name}]]>，你能帮我一个忙吗？
                  </Dialog>
                  <Button label="当然可以啦。" nextID="-1" close="true">
                    <Goto value="index_2205008"/>
                  </Button>
                </Page>
              </Script>
              <Script label="index_2205008" type="asWindow" src="task/190/190_3" winPos="0|0" name="">
                <Default>
                  <Goto value="index_2205009"/>
                </Default>
              </Script>
              
              <Script label="index_2205009" type="dialog">
                <Page id="0">
                  <Dialog npcID="220500" npcName="先知lulu">你将所有素材集齐之后，回到我这里，我为你铸造一把属于你的魔杖。</Dialog>
                  <Button label="好的。" nextID="-1" close="true">
                    <Goto value="index_2205010"/>
                  </Button>
                </Page>
              </Script>
              
              <Click label="index_2205010" event="NULL" fire="true"/>
            </Click>
          </NPCFun>
