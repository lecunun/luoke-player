  <Task id="1085" label="暗中调查">
    <!-- npcfun_g_xml · 场景 14 -->
    <NPCFun sceneID="14" label="无间道" icon="-1" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔"><![CDATA[{name}]]>，我想了很久，恐怕只有你才真正值得我信任。事实上，我发现了一个阴谋……不过，也可能只是我多心了……</Dialog>
          <Button label="究竟发生了什么呢？" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">实际上，最近刚上任的外交官，你可有所耳闻？</Dialog>
          <Button label="你说的是外交使馆的奥贝斯坦吧？" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">正是他！他和我是从小一起长大的知己，他能担当外交大使，我自然很开心！可是……最近我收到了一封匿名信，看过之后，让我很是担忧啊……</Dialog>
          <Button label="匿名信？" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="asWindow" src="task/1085/1085_0" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_4"/>
        </Default>
      </Script>
      <Script label="index_0_4" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">我和奥贝斯坦可是从小一起玩儿到大的！我们从小就一块偷幼儿园的向日葵~~从路边往过路人身上吐痰玩~啊～美好的童年！</Dialog>
          <Button label="原来你们是发小啊～！" nextID="-1" close="false">
            <Goto value="index_0_5"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_5" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">是啊～所以说，他怎么可能和黑衣人在一起呢！我真的无法相信啊d(@o@)b</Dialog>
          <Button label="你先别着急！" nextID="-1" close="false">
            <Goto value="index_0_6"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_6" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">我想请你帮我暗中监视他……虽然我知道这种做法有些卑劣，不过也实在没有办法……我必须为了王国的安全着想！</Dialog>
          <Button label="好的！我不会让他发现的！" nextID="-1" close="false">
            <Goto value="index_0_7"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_7" type="dialog">
        <Page id="0">
          <Dialog npcID="100900" npcName="麦斯威尔">你可以先去外交使馆看看，也许可以发现些什么。外交使馆就在大厅的那扇门后，进去就是了。</Dialog>
          <Button label="恩！放心吧！" nextID="-1" close="true">
            <Goto value="index_0_8"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_0_8" event="onTaskCall2" params="1|1085"/>
    </Click>
    </NPCFun>
    <!-- npcfun_c0_xml · 场景 14 -->
    <NPCFun sceneID="14" label="你刚刚在干什么？" icon="0" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="159300" npcName="奥贝斯坦">哦哦哦～那是我的猫头鹰，它只是在帮我送信而已……</Dialog>
          <Button label="送信？" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="159300" npcName="奥贝斯坦">这跟你有什么关系？你只是个魔法学院的魔法师罢了，千千万万魔法师中的一个，管这么多干嘛？</Dialog>
          <Button label="呃……是麦斯威尔让我来找你问好，恭喜你升为外交大使。[灵机一动，我也撒谎了]" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="159300" npcName="奥贝斯坦">哈哈哈！原来是那个家伙啊！我们俩可是从小一起长大的呢！</Dialog>
          <Button label="我想听听你们那时有趣的事情耶！[是真是假，一问便知]" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="asWindow" src="task/1085/1085_1" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_4"/>
        </Default>
      </Script>
      <Script label="index_0_4" type="dialog">
        <Page id="0">
          <Dialog npcID="159300" npcName="奥贝斯坦">好了，你快点去找麦斯威尔交差吧～我都告诉你啦～</Dialog>
          <Button label="交差？" nextID="-1" close="false">
            <Goto value="index_0_5"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_5" type="dialog">
        <Page id="0">
          <Dialog npcID="159300" npcName="奥贝斯坦">你就别再装了。难道不是麦斯威尔让你来试探我的么？（-_,-）现在你就回去交差吧，顺便告诉他，以后我的事情，他最好少插手，不然连朋友都没得做！</Dialog>
          <Button label="好的……[这位外交官好聪明！还是被他发现了]" nextID="-1" close="true">
            <Goto value="index_0_6"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_0_6" event="NULL" fire="true" fireID="159301"/>
    </Click>
    </NPCFun>
