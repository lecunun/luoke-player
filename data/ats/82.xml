  <Task id="128" label="再顾仙踪">
    <!-- npc_c0_xml · 场景 5 -->
    <Npc sceneID="5" type="1" npcID="145500" position="411|285">
    		<View type="0" src="145500.swf" atLayerID="2" hasClick="false"/>
    		<Click event="NULL"/>
    	</Npc>
    <!-- npcfun_c0_xml · 场景 5 -->
    <NPCFun sceneID="5" label="你好！仙灵独角兽！" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">我不是说过，你们要找的仙灵独角兽不在吗？</Dialog>
    				<Dialog npcID="145800" npcName="呱呱">那么我们愿意在这里等到传说中最强的仙灵独角兽归来，一直等，一直等。</Dialog>
    				<Dialog npcID="144800" npcName="仙灵独角兽">没有用的。你们是见不到他的——当然，他也不会见你们。</Dialog>
    				<Dialog npcID="145800" npcName="呱呱">呱呱还是那句话。对不对，<![CDATA[{name}]]>。</Dialog>
    				<Button label="当然，不达目的不罢休。" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">……（沉默了很久）</Dialog>
    				<Dialog npcID="145800" npcName="呱呱">……（沉默了很久）</Dialog>
    				<Dialog npcID="144800" npcName="仙灵独角兽">真拿你们没办法……仙灵独角兽在独角仙踪里留下了两个永恒的谜题，他曾经说过，要见他，必须要先解开这两个谜题。</Dialog>
    				<Dialog npcID="145800" npcName="呱呱">嗯！谢谢你给……啊不对，谢谢传说中的仙灵独角兽留下了这个机会给我们！我们一定会解开谜题的！</Dialog>
    				<Button label="我去找谜题解开吧！" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="NULL" fire="true" fireID="145500"/>
    	</Click>
    	</NPCFun>
    <!-- npc_c1_xml · 场景 5 -->
    <Npc sceneID="5" type="1" npcID="146000" position="354|253">
    		<View type="0" src="146000.swf" atLayerID="2"/>
    		<Click event="onRunScript">
    			<Script label="default" type="asWindow" src="task/128/128_0" winPos="0|0" name="提示">
    				<Case value="1"><Goto value="dialog_0"/></Case>
