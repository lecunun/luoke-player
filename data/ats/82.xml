<Story id="82" label="三顾仙踪">
  <Task id="126" label="说服国王">
    <!-- npc_g_xml · 场景 14 -->
    <Npc sceneID="14" type="1" npcID="145500" name="呱呱" position="582|398">
    	<View type="0" src="145500.swf" atLayerID="2"/>
    	<Create>
    	<NPCFun label="说服国王" icon="-1">
    	<Click event="onRunScript" cdtn="60">
    	<Script label="default" type="dialog">
    		<Page id="0">
    			<Dialog npcID="145500" npcName="呱呱"><![CDATA[{name}]]>，是你啊！</Dialog>
    			<Button label="呱呱！国王要见你！" nextID="-1">
    				<Goto value="dialog_1"/>
    			</Button>
    		</Page>
    	</Script>
    	<Script label="dialog_1" type="dialog">
    		<Page id="0">
    			<Dialog npcID="145500" npcName="呱呱">国王他还有什么不舒服吗？</Dialog>
    			<Dialog npcID="145500" npcName="呱呱">（仔细听取了原因）</Dialog>
    			<Dialog npcID="145500" npcName="呱呱">原来是这样……我本来不愿意牵扯到洛克王国的王室的。但既然国王要见我，我也只好去一趟了。那么我先行一步，到城堡大厅。</Dialog>
    			<Button label="我马上就到" nextID="-1" close="true">
    				<Goto value="submit"/>
    			</Button>
    		</Page>
    	</Script>
    	<Click label="submit" event="onTaskCall2" params="1|126"/>
    	</Click>
    	</NPCFun>
    	</Create>
    	<Click event="onTaskCall" cdtn="60"/>
    </Npc>
    <!-- npc_p_xml · 场景 14 -->
    <Npc sceneID="14" type="1" npcID="145600" position="456|370">
    		<View type="0" src="145600.swf" atLayerID="2" hasClick="false"/>
    		<Create>
    			<ViewEvent type="GotIt0_126_145600">
    				<Click event="onRunScript">
    					<Script label="default" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱">参见尊敬的国王圣安德鲁。</Dialog>
    							<Dialog npcID="145600" npcName="圣安德鲁">呱呱，谢谢你救了我一命。但我这次召见你，并不单为道谢你——我想知道，为什么会有东方的法术，控制了我。</Dialog>
    							<Dialog npcID="145500" npcName="呱呱">根据我在洛克王国里的调查，我推断，应该是恩佐和年兽，勾结了起来。</Dialog>
    							<Dialog npcID="145600" npcName="圣安德鲁">那么，你西行而来，想必已经了解好一切了，也想好了解决的方法吧。</Dialog>
    							<Dialog npcID="145500" npcName="呱呱">国王圣明。</Dialog>
    							<Button label="啊？方法是什么？" nextID="-1" close="true">
    								<Goto value="asWindow_0"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="asWindow_0" type="asWindow" src="task/126/126_0" winPos="0|0" name="提示">
    						<Default><Goto value="dialog_1"/></Default>
    					</Script>
    					<Script label="dialog_1" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱">陛下，这正是呱呱不明智的建议，万望指教。</Dialog>
    							<Dialog npcID="145600" npcName="圣安德鲁">呵呵，你的建议非常好，又怎么是不明智呢。但是，我还想听一下具体的方案。我们的合作，究竟要怎么做？</Dialog>
    							<Dialog npcID="145500" npcName="呱呱">我们有两个方面，是事不宜迟的。一是寻找传说中最强的仙灵独角兽，二是重新夺回玄玉岛的准备。</Dialog>
    							<Dialog npcID="145600" npcName="圣安德鲁">这是为什么呢？</Dialog>
    							<Dialog npcID="145500" npcName="呱呱">我们两方面，只能各自对一方进行克制，但并没有办法致胜。要想赢过对方，我们必须要找到帮手。如果传说中最强的仙灵独角兽能够帮我们，那么我们是必胜无疑。</Dialog>
    							<Button label="传说中的仙灵独角兽这么厉害？" nextID="-1" close="true">
    								<Goto value="asWindow_1"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="asWindow_1" type="asWindow" src="task/126/126_1" winPos="0|0" name="提示">
    						<Default><Goto value="dialog_2"/></Default>
    					</Script>
    					<Script label="dialog_2" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱">这就是强大的仙灵独角兽。而另外一个方面……呱呱希望陛下能帮助我们的……就是，救出平阳公主。</Dialog>
    							<Dialog npcID="145600" npcName="圣安德鲁">既然平阳公主才能牵制年兽，我当然是不会推迟的。战船，物资等，我这边准备好。等你把传说中最强的仙灵独角兽带过来，我们就一起远征玄玉岛。</Dialog>
    							<Dialog npcID="145500" npcName="呱呱">国王英明！</Dialog>
    							<Button label="国王英明！" nextID="-1" close="true">
    								<Goto value="submit"/>
    							</Button>
    						</Page>
    					</Script>
    					<Click label="submit" event="NULL" fire="true"/>
    				</Click>
    			</ViewEvent>
    			<ViewEvent type="GotIt1_126_145600">
    				<Click event="onRunScript">
    					<Script label="default" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱"><![CDATA[{name}]]>，你要和我一起去寻找传说中最强的仙灵独角兽吗？</Dialog>
    							<Button label="那是当然的啊！" nextID="-1">
    								<Goto value="dialog_1"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_1" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱">你可知道仙灵独角兽隐居多时，途中会遇到什么险阻，完全不知道的哦。</Dialog>
    							<Button label="我不怕！" nextID="-1">
    								<Goto value="dialog_2"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_2" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145500" npcName="呱呱">有你这个朋友真好。那么，我们向独角仙踪出发吧。只有那里，才会找到那传说中最为聪明，最为强大的仙灵独角兽。</Dialog>
    							<Button label="出发吧！" nextID="-1" close="true">
    								<Goto value="submit"/>
    							</Button>
    						</Page>
    					</Script>
    					<Click label="submit" event="onTaskCall2" params="2|126"/>
    				</Click>
    			</ViewEvent>
    		</Create>
    	</Npc>
  </Task>
  <Task id="127" label="仙踪奇遇">
    <!-- npc_c0_xml · 场景 5 -->
    <Npc sceneID="5" type="1" npcID="145800" position="411|285">
    	<View type="0" src="145800.swf" atLayerID="2" hasClick="false"/>
    	<Create>
    		<ViewEvent type="GotIt0_127_145800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="145800" npcName="呱呱">且慢！这位尊敬的仙灵独角兽，我是来自东方的玄玉岛的！我叫呱呱！</Dialog>
    						<Dialog npcID="144800" npcName="仙灵独角兽">（仙灵独角兽总算停下了攻击）</Dialog>
    						<Dialog npcID="144800" npcName="仙灵独角兽">东方……玄玉岛……</Dialog>
    						<Dialog npcID="145800" npcName="呱呱">（长叹了一口气）</Dialog>
    						<Dialog npcID="145800" npcName="呱呱">我们不是有意入侵你的仙境，我们是有事相求，才会不知礼节，贸然所致，万望见谅！</Dialog>
    						<Dialog npcID="144800" npcName="仙灵独角兽">你们来这里是为什么。</Dialog>
    						<Dialog npcID="145800" npcName="呱呱">（长叹了一口气）</Dialog>
    						<Dialog npcID="145800" npcName="呱呱">我们为了寻找传说中的仙灵独角兽——最为强大与最为聪慧的仙灵独角兽。</Dialog>
    						<Dialog npcID="144800" npcName="仙灵独角兽">……</Dialog>
    						<Button label="请问您知道吗？" nextID="-1" close="true">
    							<Goto value="asWindow_0"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_0" type="asWindow" src="task/127/127_0" winPos="0|0" name="提示">
    					<Default><Goto value="dialog_1"/></Default>
    				</Script>
    				<Script label="dialog_1" type="dialog">
    					<Page id="0">
    						<Dialog npcID="144800" npcName="仙灵独角兽">你们要找的，是我的恩人，我的师傅，世人叫他传说中的仙灵独角兽。但是他进入了山中，云雾很深，并不知道地方。我想，你们还是走吧。</Dialog>
    						<Button label="等、等一下啊！" nextID="-1" close="true">
    							<Goto value="submit"/>
    						</Button>
    					</Page>
    				</Script>
    				<Click label="submit" event="NULL" fire="true"/>
    			</Click>
    		</ViewEvent>
    	</Create>
    </Npc>
    <!-- npcfun_c0_xml · 场景 5 -->
    <NPCFun sceneID="5" label="你好！仙灵独角兽！" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">你们，究竟是什么人，竟敢入侵独角仙踪？接招吧！</Dialog>
    				<Button label="啊，不听我说就开打了？" nextID="-1" close="true">
    					<Goto value="combat_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="combat_0" type="switch" invoke="combat" args="2|144800|仙灵独角兽">
    			<Default><Goto value="submit"/></Default>
    		</Script>
    		<Click label="submit" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state0_127_140300"/>
    	</Click>
    	</NPCFun>
    <!-- npc_p_xml · 场景 5 -->
    <Npc sceneID="5" type="1" npcID="145900" position="316|453">
    		<View type="0" src="145900.swf" atLayerID="2" hasClick="false"/>
    		<Create>
    			<ViewEvent type="GotIt0_127_145900">
    				<Click event="onRunScript" aimPos="316|453" cdtn="60">
    					<Script label="default" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145900" npcName="呱呱">救命，这就被撵出来了。</Dialog>
    							<Button label="我看这其中有蹊跷" nextID="-1">
    								<Goto value="dialog_1"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_1" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145900" npcName="呱呱">你也觉得是吧，我看那仙灵独角兽肯定有什么隐瞒着我们。</Dialog>
    							<Button label="一定要再回去看看！" nextID="-1" close="true">
