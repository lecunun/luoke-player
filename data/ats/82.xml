    <!-- npc_p_xml · 场景 5 -->
    <Npc sceneID="5" type="1" npcID="145900" position="316|453">
    		<View type="0" src="145900.swf" atLayerID="2" hasClick="false"/>
    		<Create>
    			<ViewEvent type="GotIt0_128_145900">
    				<Click event="onRunScript" aimPos="316|453" cdtn="60">
    					<Script label="default" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145900" npcName="呱呱">又被撵出来了。</Dialog>
    							<Button label="他是不想我们知道什么吗？" nextID="-1">
    								<Goto value="dialog_1"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_1" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145900" npcName="呱呱">因为……他就是仙灵独角兽……</Dialog>
    							<Dialog npcID="145900" npcName="呱呱">如果没有实际的证据，我觉得他是不会出山的。云雾长城和迷魂八卦里，有年兽肆虐的痕迹。我们把那些痕迹拿过来，让他看到玄玉岛的危机，这样他才会知道，我们急需要他的帮忙。</Dialog>
    							<Button label="同感啊！" nextID="-1">
    								<Goto value="dialog_2"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_2" type="dialog">
    						<Page id="0">
    							<Dialog npcID="145900" npcName="呱呱"><![CDATA[{name}]]>，我能拜托你走这一趟吗？我还到独角仙踪去，尽我最大的努力去劝说，加上你拿回来的证据，传说中的仙灵独角兽应该就会出现啦！</Dialog>
    							<Button label="看我的吧！" nextID="-1" close="true">
    								<Goto value="submit"/>
    							</Button>
    						</Page>
    					</Script>
    					<Click label="submit" event="onTaskCall2" params="2|128"/>
    				</Click>
    			</ViewEvent>
    		</Create>
    	</Npc>
