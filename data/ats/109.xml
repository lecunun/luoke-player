        </Page>
      </Script>
      <Script label="index_0_3" type="dialog">
        <Page id="0">
          <Dialog npcID="109900" npcName="乐乐">是的。而用海螺演奏出的音乐，是具有驱逐海洋中邪恶的能力的。</Dialog>
          <Button label="还有这等事情！" nextID="-1" close="true">
            <Goto value="index_0_4"/>
