    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">的确……在沿岸发生了非常严重的海啸。但据各位研究员的研究报告，最近地壳并没有异动。</Dialog>
          <Button label="那是不是说……" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">对，应该是人为的异动。是魔法，或者怪物之力。</Dialog>
          <Button label="恩佐又来搞事啦？" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">我还不能确定。现在魔法学院正倾尽全力去搜寻事实的真相。<![CDATA[{name}]]>，作为学院的一份子，你也要参与进来。</Dialog>
          <Button label="义不容辞！" nextID="-1" close="false">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">到海边去吧，找沿海的居民，寻找真相。</Dialog>
          <Button label="谨遵师命！" nextID="-1" close="true">
            <Goto value="index_0_4"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_0_4" event="onTaskCall2" params="1|140"/>
    </Click>
    </NPCFun>
