    <!-- npcfun_g_xml · 场景 14 -->
    <NPCFun sceneID="14" label="杰克的礼物" icon="-1" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="100900" npcName="麦斯威尔">杰克的生日要到了，大家都想感谢他一下，我们悄悄的给他准备了一些礼物，帮助大家送给杰克吧。</Dialog>
    				<Button label="都要找谁呢？">
    					<Goto value="nextdialog"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="nextdialog" type="dialog">
    			<Page id="0">
    				<Dialog npcID="100900" npcName="麦斯威尔">先问问海德估计他有东西要给杰克。</Dialog>
    				<Button label="现在就去" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    				<Button label="一会再说" close="true">
    					<End/>
    				</Button>
    			</Page>
    		</Script>
    	
    		<Click label="submit" event="onTaskCall2" params="1|4023"/>
    	</Click>
    	</NPCFun>
    <!-- npcfun_ged_xml · 场景 14 -->
    <NPCFun sceneID="14" label="杰克的礼物" icon="0" close="false">
    		<Click event="onRunScript">
    			<Script label="default" type="dialog">
    				<Page id="0">
    					<Dialog npcID="100900" npcName="麦斯威尔">小洛克，托比、海德、希罗，想想你把谁忘了？</Dialog>
    					<Button label="我再找找" close="true">
    						<End/>
    					</Button>
    				</Page>
    			</Script>
    		</Click>
    	</NPCFun>
    <!-- npcfun_c0_xml · 场景 81 -->
    <NPCFun sceneID="81" label="杰克的礼物" icon="0" close="false">
    	<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="128200" npcName="海德">上次他托洛克送来的龙骨化石真的很稀有，我这里有个触角草龙送我的围巾给他吧。</Dialog>
    						<Button label="嗯，好的。">
    							<Goto value="nextdialog"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="nextdialog" type="dialog">
    					<Page id="0">
    						<Dialog npcID="128200" npcName="海德">对了，据说雪人谷的希罗和矿洞深处的托比都要给他礼物哦。</Dialog>
    						<Button label="知道了" close="true">
    							<Goto value="sumbit"/>
    						</Button>
    					</Page>
    				</Script>
