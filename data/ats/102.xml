    		<Click event="onRunScript">
    							<Script type="dialog" label="default">
    								<Page>
    									<Dialog npcID="110100" npcName="杰克"><![CDATA[{name}]]>，你过来下，如此危险的矿山你怎么不带安全帽呢？</Dialog>
    									<Button label="我是来给你送礼物的。">
    										<Goto value="dialog_1"/>
    									</Button>
    								</Page>
    							</Script>
    							<Script label="dialog_1" type="dialog">
    								<Page>
    									<Dialog npcID="110100" npcName="杰克">什么？</Dialog>
