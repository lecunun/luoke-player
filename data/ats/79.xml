    			<Page id="0">
    				<Dialog npcID="100900" npcName="麦斯威尔">没。。。没有。。。。什么都没有发生。。。。。国王能有什么事情，哈哈哈哈，开玩笑。</Dialog>
    				<Button label="我没有问国王啊" nextID="-1">
