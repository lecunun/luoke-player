    	<Create>
    	<NPCFun label="蹊跷" icon="-1">
    	<Click event="onRunScript" cdtn="60">
    	<Script label="default" type="dialog">
    		<Page id="0">
    			<Dialog npcID="141200" npcName="呱呱">最近为了疗伤，每到深夜我都会打坐入静。伤势好的很快，但是有一点，我发现了一些奇怪的事情。</Dialog>
    			<Button label="发现了什么" nextID="-1">
    				<Goto value="dialog_1"/>
    			</Button>
    		</Page>
    	</Script>
    	<Script label="dialog_1" type="dialog">
    		<Page id="0">
    			<Dialog npcID="141200" npcName="呱呱">当我入静的时候，我的元神在洛克王国恍恍惚东游西荡。结果到了皇宫上方发现笼罩着一团紫色的乌云。。。。。</Dialog>
    			<Button label="紫色的乌云？" nextID="-1" close="true">
    				<Goto value="asWindow_0"/>
    			</Button>
    		</Page>
    	</Script>
    	<Script label="asWindow_0" type="asWindow" src="task/3029/3029_0" winPos="0|0" name="提示">
    		<Default><Goto value="dialog_2"/></Default>
    	</Script>
    	<Script label="dialog_2" type="dialog">
    		<Page id="0">
    			<Dialog npcID="141200" npcName="呱呱">云雾中隐含的的力量既有东方的魔法气息，也有你们洛克王国的魔法气息。和之前解除年兽封印的魔法力量非常相似。</Dialog>
    			<Dialog npcID="141200" npcName="呱呱">我怀疑那个解除了年兽封印的不知名的邪恶巫师也到了洛克王国。并且正在王宫实施什么邪恶魔法。</Dialog>
    			<Button label="我估计是黑巫师恩佐，你看看你当时看到的是不是这个人？" nextID="-1" close="true">
    				<Goto value="asWindow_1"/>
    			</Button>
    		</Page>
    	</Script>
    	<Script label="asWindow_1" type="asWindow" src="task/3029/3029_1" winPos="0|0" name="提示">
    		<Default><Goto value="dialog_3"/></Default>
    	</Script>
    	<Script label="dialog_3" type="dialog">
    		<Page id="0">
    			<Dialog npcID="141200" npcName="呱呱">看来我终于找到那个毁灭了玄玉国的罪魁祸首了。可是我一个人也拿他没办法，需要借助你们洛克王国的力量。我们要尽快，否则随着他对东西方魔法的融会贯通。他的力量能将两个王国都毁掉。</Dialog>
    			<Button label="我一定会阻止它" nextID="-1" close="true">
    				<Goto value="submit"/>
    			</Button>
    		</Page>
    	</Script>
    	<Click label="submit" event="onTaskCall2" params="1|3029"/>
    	</Click>
    	</NPCFun>
    	</Create>
    	<Click event="onTaskCall" cdtn="20"/>
    </Npc>
    <!-- npcfun_c0_xml · 场景 32 -->
