    <!-- npc_p_xml · 场景 19 -->
    <Npc sceneID="19" type="1" npcID="135600" name="蔷薇骑士" position="433|385">
    <View type="0" src="135600.swf" atLayerID="2"/>
    <Create>
    <NPCFun label="千里走单骑" icon="0" close="false">
    	<Click event="onRunScript" cdtn="60">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">如果我没猜错，你是受罗宾的委托，来找我的吧！你说菲尔特的咕噜球？</Dialog>
    				<Button label="请你把菲尔特的咕噜球交给我吧！" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">你知道他虐待宠物的事情吗？他总是欺负宠物，不但不给它们食物吃，而且让它们干很多活。你不觉得它们很可怜吗！</Dialog>
    				<Button label="这……萌萌的确有说过……" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">所以说，我把宠物球拿走，是为了救这些宠物啊！我这样做有错吗？难道你不觉得我做的都是正确的吗？</Dialog>
    				<Button label="可是……你拿了他的东西就是不对啊" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">既然如此……看来你是来给我下战书的！如果你执意要来挑战我，作为骑士，我当然也会欣然接受。</Dialog>
    				<Button label="那么就比试一下吧！" nextID="-1" close="true">
    					<Goto value="combat_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="combat_0" type="switch" invoke="combat" args="2|135600|蔷薇骑士">
    			<Default><Goto value="dialog_4"/></Default>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士"><![CDATA[{name}]]>，我看得出，你已经尽力了！显然，你想打败我，是根本不可能的。哈哈，作为骑士，我绝对不会以大欺小的！刚刚只是初试牛刀，真正的比试现在才开始！</Dialog>
    				<Button label="现在才开始？" nextID="-1">
    					<Goto value="dialog_5"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_5" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">那当然！我可没说挑战就是比试剑法！</Dialog>
    				<Button label="那要怎么挑战呢？" nextID="-1">
    					<Goto value="dialog_6"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_6" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">这样吧，这片沙滩上埋藏着一块石碑，记载蓝色蔷薇种子地点。你要找到石碑，看看种子埋藏的地点。然后把蔷薇种子找来，放到沙滩的杯子里，最后转动杯子！我们来打赌！</Dialog>
    				<Button label="打赌？怎么玩？" nextID="-1">
    					<Goto value="dialog_7"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_7" type="dialog">
    			<Page id="0">
    				<Dialog npcID="135600" npcName="蔷薇骑士">很简单啊！猜猜蔷薇种子在哪个杯子里。如果你猜中了，我就把宠物球的所在地告诉你。如果我猜中了，你就立刻从我眼前消失。</Dialog>
    				<Button label="我接受挑战" nextID="-1" close="true">
    					<Goto value="submit"/> 
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="2|1053"/>
    	</Click>
    </NPCFun>
    </Create>
    <Click event="onTaskCall" cdtn="60">
    <Dialog>蔷薇骑士，自古以蔷薇头盔为传承。为了荣誉，为了正义，我必须要将正义坚持下去，就算不被世人所理解。</Dialog>
    </Click>
    </Npc>
