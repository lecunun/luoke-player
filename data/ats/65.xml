    			<Page id="0">
    				<Dialog npcID="112001" npcName="萌萌">那天我就看到他啦！菲尔特让他的宠物干很重的活，像苦力一样！宠物们都很可怜，我看着都心疼！没想到蔷薇骑士突然出现了，看起来十分生气，然后把装有宠物的咕噜球抢走了。</Dialog>
    				<Button label="好的" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="NULL" fire="true"/>
