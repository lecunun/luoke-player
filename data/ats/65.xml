<Story id="65" label="蔷薇骑士异闻录">
  <Task id="1051" label="打探蔷薇骑士的消息">
    <!-- npcfun_g_xml · 场景 29 -->
    <NPCFun sceneID="29" label="蔷薇骑士异闻录" icon="-1" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101300" npcName="罗宾">最近蔷薇骑士又出现了，还把菲尔特的宠物放跑了，刚刚菲尔特来找我，委托我帮他找到宠物。</Dialog>
    				<Button label="蔷薇骑士？" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101300" npcName="罗宾">唉，这蔷薇骑士真是让我头疼啊，每次他的出现都伴随着巨大的话题性。什么？你还不知道蔷薇骑士的故事？那你最好去多方位打听一下！</Dialog>
    				<Button label="好的" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="1|1051"/>
    	</Click>
    	</NPCFun>
    <!-- npcfun_p_xml · 场景 29 -->
    <NPCFun sceneID="29" label="我打听了蔷薇骑士的消息啦！" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script type="switch" label="default">
    			<Func invoke="taskIsComplete" args="1051"/>
    			<Case value="0"><Goto value="no"/></Case>
    			<Case value="1"><Goto value="yes"/></Case>
    		</Script>
    		<Script label="no" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101300" npcName="罗宾">关于蔷薇骑士的传说有很多呢。如果你还一点都不知道，最好去打听一下！如果你对他的事情一点都不知道，接下来的事情也很难去做了。</Dialog>
    				<Button label="好的" nextID="-1" close="true">
    					<End/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="yes" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101300" npcName="罗宾">看来你已经对蔷薇骑士有些了解了。其实我本人对他的态度倒是没什么，主要是他抢走了菲尔特的宠物和咕噜球，菲尔特来这里委托我帮他，所以我们要帮他把宠物和咕噜球找回来。</Dialog>
    				<Button label="恩！那是一定的" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101300" npcName="罗宾">不过传闻蔷薇骑士的剑法高明，又十分聪明，如果不是智勇双全的小洛克，恐怕很难和他对抗，为此我也准备了一些考验。<![CDATA[{name}]]>，只有你通过这些考验，才能把菲尔特的委托放心交给你。</Dialog>
    				<Button label="好的" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="2|1051"/>
    	</Click>
    	</NPCFun>
    <!-- npcfun_c0_xml · 场景 29 -->
    <NPCFun sceneID="29" label="你知道蔷薇骑士吗?" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101100" npcName="艾迪">你是说那个英俊潇洒的蔷薇骑士吗？当然知道啦！他还帮过我呢！</Dialog>
    				<Button label="他帮过你？能不能和我说一下？" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1051/1051_0" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_1"/></Default>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101100" npcName="艾迪">所以说，蔷薇骑士是个好人呢！</Dialog>
    				<Button label="谢谢你，艾迪" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="NULL" fire="true"/>
    	</Click>
    </NPCFun>
    <!-- npcfun_c1_xml · 场景 29 -->
    <NPCFun sceneID="29" label="你知道蔷薇骑士吗?" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="100200" npcName="莫里亚克">呵呵，看来最近蔷薇骑士成了红人啊！你看看我这里的报纸，刚刚报道了关于他的事情呢！</Dialog>
    				<Button label="我来看看" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1051/1051_1" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_1"/></Default>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="100200" npcName="莫里亚克">关于他的评价，一直以来都很难说呢，一会帮助别人，一会又兴风作浪，真是让我头疼啊！</Dialog>
    				<Button label="谢谢你，莫里亚克" nextID="-1" close="true">
    					<Goto value="submit"/>
