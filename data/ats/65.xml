    <!-- npcfun_p_xml · 场景 14 -->
    <NPCFun sceneID="14" label="罗宾的考验" icon="0" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="105300" npcName="哥顿">原来是大侦探罗宾让你来找我的啊！的确，最近蔷薇骑士又出现了，让我很头大呢！</Dialog>
    				<Button label="究竟是怎么回事" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="105300" npcName="哥顿">蔷薇骑士总是神出鬼没的！明明我们已经严格巡查了，还是逮不到他！我倒是推测了几种可能，你能帮我分析一下吗？</Dialog>
    				<Button label="一定尽力" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1052/1052_0" winPos="0|0" name="提示">
    			<Case value="0"><Goto value="no"/></Case>
    			<Case value="1"><Goto value="yes"/></Case>
    		</Script>
    		<Script label="no" type="dialog">
    			<Page id="0">
    				<Dialog npcID="105300" npcName="哥顿">为什么我觉得怪怪的……<![CDATA[{name}]]>，是不是你推理错了呢？</Dialog>
    				<Button label="我再试试" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    				<Button label="我的头都大了" nextID="-1" close="true">
    					<End/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="yes" type="dialog">
    			<Page id="0">
    				<Dialog npcID="105300" npcName="哥顿">不愧是罗宾推荐的人选，就是比我聪明啊！<![CDATA[{name}]]>，可能有一件事你还不知道，那就是蔷薇骑士经过的地方，都会留下蓝色蔷薇。</Dialog>
    				<Button label="蓝色蔷薇？" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="105300" npcName="哥顿">是啊！只要沿着蓝色蔷薇，就一定可以找到蔷薇骑士！既然罗宾如此信任你，那么追捕蔷薇骑士的任务，就交给你啦！快点去找找，哪里有蓝色蔷薇吧！</Dialog>
    				<Button label="定不负所托" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="2|1052"/>
    	</Click>
    </NPCFun>
