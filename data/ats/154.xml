  <Task id="2014" label="呆小路的兄弟">
    <!-- npc_g_xml · 场景 57 -->
    <Npc sceneID="57" type="1" npcID="186600" position="307|407">
    	<View type="0" src="186600.swf" atLayerID="1"/>
    		<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="165200" npcName="呆小路"><![CDATA[{name}]]>，你说公主她什么时候回来呀？都是恩佐那个坏蛋，我要去和他拼了！</Dialog>
    				<Button label="冷静！呆小路，你打不过他的。">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page>
    				<Dialog npcID="165200" npcName="呆小路">那怎么办？就这样看着公主被他抢去？如果我的弟弟们在就好了！</Dialog>
    				<Button label="你的兄弟？">
    				<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page>
    				<Dialog npcID="165200" npcName="呆小路">对！当年恩佐把我们拿去实验，后来我们失散了……我们七个都拥有不同的特殊能力，你应该还记得吧？</Dialog>
    				<Dialog npcID="165200" npcName="呆小路">二弟拥有超强的治愈能力，四弟是雷霆峡谷一霸，对电掌控力很强，还有可以把幻想变成现实的五弟笛笛笔……</Dialog>
    				<Button label="如果你们兄弟齐心，肯定可以救回公主！">
    				<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page>
    				<Dialog npcID="165200" npcName="呆小路">可我们失散多年，都不知道从哪开始找起……那就先去问问萌萌，有没有二弟的消息吧！</Dialog>
    				<Button label="好，我陪你去！" close="true">
    				<Goto value="sumbit"/>
    				</Button>
    			</Page>
    		</Script>
    	
    		<Click label="sumbit" event="onTaskCall2" params="1|2014"/>
    		</Click>
    	</Npc>
