    		</Script>
    		<Script label="dialog_2" type="dialog">
    				<Page id="0">
    					<Dialog npcID="186800" npcName="笛笛笔">别忘了还有我！我能把幻想中的变成现实，来吧！正义的千军万马，消灭恶魔叮！ </Dialog>
