    	<Click event="onRunScript">
    			<Script label="default" type="dialog">
    				<Page id="0">
    					<Dialog npcID="158900" npcName="恩佐">？？？</Dialog>
    					<Dialog npcID="158900" npcName="恩佐">奇怪，我在这做什么？你们怎么也在这里！</Dialog>
    					<Button label="我们只是路过，路过，打打酱油。" close="false">
