            <Script label="dialog_2" type="dialog">
                <Page id="0">
                    <Dialog npcID="101600" npcName="吉洛斯">下水道的漂流探险、怀特冰川的雪山探险，快去看看吧。</Dialog>
                    <Button label="下水道的的漂流探险，怀特冰川的雪山探险，知道了" nextID="-1" close="true">
