                    </Button>
                    <Button label="考虑一下" nextID="-1" close="true"/>
                </Page>
            </Script>
            <Click label="accpet" event="onTaskCall2" params="1|4030"/>
        </Click>
    </NPCFun>
    <!-- npcfun_101600_submit · 场景 32 -->
    <NPCFun sceneID="32" label="洛克大探险" icon="0" close="false">
        <Click event="onRunScript">
            <Script label="default" type="switch">
                <Func invoke="taskIsComplete" args="4030"/>
                <Case value="0"><Goto value="notOK"/></Case>
                <Case value="1"><Goto value="ok"/></Case>
            </Script>
            <Script label="notOK" type="dialog">
                <Page id="0">
                    <Dialog npcID="101600" npcName="吉洛斯">下水道的的漂流探险、怀特冰川的雪山探险哪个没有完成？好好想想。</Dialog>
                    <Button label="谢谢你！我继续找！" nextID="-1" close="true"/>
