  <Task id="1062" label="不打不相识">
    <!-- npc_p_xml · 场景 32 -->
    <Npc sceneID="32" type="1" npcID="141800" position="452|285">
    	<View type="0" src="141800.swf" atLayerID="2" hasClick="false"/>
    	<Create>	
    		<ViewEvent type="GotIt0_1062_141800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="101600" npcName="吉洛斯"><![CDATA[{name}]]>，你来得正好！快！我估计它快坚持不了多久了！</Dialog>
    						<Button label="我带来了人参果酒！" nextID="-1">
    							<Goto value="dialog_2"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_2" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">平阳公主……平阳公主……</Dialog>
    						<Dialog npcID="101600" npcName="吉洛斯">它好像在做梦，一直都在叫着平阳公主。快，我们把人参果酒给它喝下去！相信它很快就会好起来的！</Dialog>
    						<Button label="平阳公主应该是对它来说很重要的人吧……" nextID="-1" close="true">
    							<Goto value="asWindow_0"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_0" type="asWindow" src="task/1062/1062_0" winPos="0|0" name="提示">
    					<Default><Goto value="submit"/></Default>
    				</Script>
    				<Click label="submit" event="NULL" fire="true"/>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="GotIt1_1062_141800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">我看起来应该恢复了！<![CDATA[{name}]]>，还有吉洛斯，谢谢你们啦！！我还没有自我介绍，我叫做呱呱！</Dialog>
    						<Button label="你终于恢复啦！这块玉佩也还给你吧！" nextID="-1">
    							<Goto value="dialog_2"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_2" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">（双手接过玉佩，小心翼翼地放到腰间）恩！这是对我来说很重要的东西……谢谢你们……</Dialog>
    						<Dialog npcID="101600" npcName="吉洛斯">平阳公主是谁？你昏迷不醒的时候，一直喊着她的名字。</Dialog>
    						<Dialog npcID="142000" npcName="呱呱">她……她是对我而言很重要的人……是我无论如何，拼上性命都要守护的人！</Dialog>
    						<Button label="她也在玄玉岛吗？你是怎么来到洛克王国的？" nextID="-1" close="true">
    							<Goto value="asWindow_0"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_0" type="asWindow" src="task/1062/1062_1" winPos="0|0" name="提示">
