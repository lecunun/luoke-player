    					</Button>
    				</Page>
    			</Script>
    			<Script label="dialog_3" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101600" npcName="吉洛斯">它这是休克了！<![CDATA[{name}]]>，快！我们必须快点救治它！</Dialog>
    					<Button label="55555！我真的不是有意的！可是要怎么做！" nextID="-1">
    						<Goto value="dialog_4"/>
    					</Button>
    				</Page>
    			</Script>
    			<Script label="dialog_4" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101600" npcName="吉洛斯">废话少说！看起来它好像不是洛克王国的，不知道我的那些救治方法对它有没有用！唉！不试试也不知道结果！</Dialog>
    					<Button label="那就快点吧！" nextID="-1" close="true">
    						<Goto value="asWindow_0"/>
    					</Button>
    				</Page>
    			</Script>
    			<Script label="asWindow_0" type="asWindow" src="task/1060/1060_3" winPos="0|0" name="提示">
