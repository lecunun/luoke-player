<Story id="77" label="逃亡">
  <Task id="1060" label="神秘的玉佩">
    <!-- npcfun_g_xml · 场景 32 -->
    <NPCFun sceneID="32" label="逃亡" icon="-1" close="false">
    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101600" npcName="吉洛斯"><![CDATA[{name}]]>，其实我找你来，是因为我发现了一块神奇的石头！以前在王国里，可从来没有见过这种质地的石头耶！</Dialog>
    				<Button label="探险协会会长都不知道，我就更不知道啦！" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101600" npcName="吉洛斯">所以我们更要好好研究一下！你看！这个石头又在发光了！它好像知道我们在谈论它呢！好像隐约还能看到什么！</Dialog>
    				<Button label="真有这么神奇！？让我来看看" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1060/1060_0" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_2"/></Default>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101600" npcName="吉洛斯">石头里面的景象是哪里呢？其实这块石头是船长拉瓦给我的。他们出海归来时，在船上发现了这块奇异的石头，才拿来给我鉴定。</Dialog>
    				<Button label="看来出海总是能发现神奇的宝贝呢！" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="101600" npcName="吉洛斯">你能帮我查查这块石头的来历吗？你去问问他，到底是怎么发现这块石头的吧！这块石头有很强的能量场！貌似有很强的魔力呢！</Dialog>
    				<Button label="这就去钻石港，找问问拉瓦！" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="1|1060"/>
    	</Click>
    	</NPCFun>
    <!-- npcfun_c0_xml · 场景 32 -->
    <NPCFun sceneID="32" label="给我讲讲发现奇怪石头的事情吧" icon="0" close="false">
    		<Click event="onRunScript">
    			<Script label="default" type="dialog">
    				<Page id="0">
    					<Dialog npcID="122300" npcName="拉瓦">呵呵，消息传得真快啊～！肯定是下水道吉洛斯那个老怪告诉你的吧！</Dialog>
    					<Button label="嗯嗯！就是吉洛斯让我来问你的！" nextID="-1">
    						<Goto value="dialog_2"/>
    					</Button>
    				</Page>
    			</Script>
    			<Script label="dialog_2" type="dialog">
    				<Page id="0">
    					<Dialog npcID="122300" npcName="拉瓦">我能感觉到，这块石头的能量很强大！它一定非比寻常！但是它究竟来自哪里呢？它的主人又是谁呢？它为什么会在我的船上呢？</Dialog>
    					<Button label="你能详细说说发现它的过程么？" nextID="-1" close="true">
    						<Goto value="asWindow_0"/>
    					</Button>
    				</Page>
    			</Script>
    			<Script label="asWindow_0" type="asWindow" src="task/1060/1060_1" winPos="0|0" name="提示">
    				<Default><Goto value="dialog_3"/></Default>
    			</Script>
    			<Script label="dialog_3" type="dialog">
    				<Page id="0">
    					<Dialog npcID="122300" npcName="拉瓦">我倒是建议你，可以去图书馆，看看那些关于石头的书里，有没有关于这种石头的记载。</Dialog>
    					<Button label="现在就去" nextID="-1" close="true">
    						<Goto value="submit"/>
    					</Button>
    				</Page>
    			</Script>
    			<Click label="submit" event="NULL" fire="true"/>
    		</Click>
    	</NPCFun>
