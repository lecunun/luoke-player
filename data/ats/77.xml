    <NPCFun sceneID="32" label="帮忙救治呱呱" icon="0" close="false">
    		<Click event="onRunScript">
    			<Script label="default" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101600" npcName="吉洛斯">你们在上面那么吵！究竟发生什么事啦！<![CDATA[{name}]]>～你竟然还欺负弱者！</Dialog>
    					<Dialog npcID="141200" npcName="呱呱">他……他拿了我的玉佩……还打伤了我……</Dialog>
    					<Button label="我不是故意的！玉佩？就是那块石头？" nextID="-1">
    						<Goto value="dialog_2"/>
    					</Button>
    				</Page>
    			</Script>
    			<Script label="dialog_2" type="dialog">
    				<Page id="0">
    					<Dialog npcID="141200" npcName="呱呱">快点……快点把它还给我……我还要回去……平阳公主……我……</Dialog>
    					<Button label="它好像晕过去了！" nextID="-1">
