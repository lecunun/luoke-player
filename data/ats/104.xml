    <NPCFun sceneID="7" label="诡异的声响" icon="-1" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="105100" npcName="爱德华">最近一到夜晚，就有诡异的事情，吓得我都不敢在图书馆读书了……</Dialog>
          <Button label="发生了什么呢？" nextID="-1" close="true">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="asWindow" src="task/4024/4024_0" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_2"/>
        </Default>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="105100" npcName="爱德华">估计是那个书架上的东西在搞鬼，帮我看看是怎么回事好吗？</Dialog>
          <Button label="好吧，找个胆大的朋友一起来找找看" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="asWindow" src="task/4024/4024_1" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_4"/>
        </Default>
      </Script>
      <Script label="index_0_4" type="dialog">
        <Page id="0">
          <Dialog npcID="105100" npcName="爱德华">？？？</Dialog>
          <Button label="爱德华快来看看我发现了什么？" nextID="-1" close="false">
            <Goto value="index_0_5"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_5" type="dialog">
        <Page id="0">
          <Dialog npcID="105100" npcName="爱德华">这是？</Dialog>
          <Button label="翻开图书" nextID="-1" close="true">
            <Goto value="index_0_6"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_6" type="asWindow" src="task/4024/4024_2" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_7"/>
        </Default>
      </Script>
      <Script label="index_0_7" type="dialog">
        <Page id="0">
          <Dialog npcID="105100" npcName="爱德华">它说残缺的记忆？那个地方好像是龙之秘境的龙守望、弃之宝岛的黑影之岭，你去看看有什么线索没？</Dialog>
          <Button label="好的" nextID="-1" close="true">
            <Goto value="index_0_8"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_0_8" event="onTaskCall2" params="1|4024"/>
    </Click>
