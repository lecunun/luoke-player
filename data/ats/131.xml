    		</Click>
    	</NPCFun>
    <!-- npc_wz_xml · 场景 138 -->
    <Npc sceneID="138" type="1" npcID="173800" position="628|311" aimPos="628|311" name="伍兹">
    		<View type="0" src="173800.swf" atLayerID="2" hasClick="true"/>
    		   <Create>
    				<Task id="2006" care="2"/>
    			</Create>
    			<Click event="onRunScript">
    			  <Script label="default" type="dialog">
    			    <Page id="0">
    			      <Dialog npcID="173800" npcName="伍兹">哦？你是院长派来的帮手？看看我的成果吧！一个即将载入史册的建筑诞生了！你看这浮雕，你看这纹理……</Dialog>
    			      <Button label="那三个奇怪的盘子是什么？" nextID="-1" close="false">
    			        <Goto value="index_0_1"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_1" type="dialog">
    			    <Page id="0">
    					<Dialog npcID="173800" npcName="伍兹">盘子？那是专用来摆放“神器”的器皿！你不要小看这座魔法台，它的朝向、石料材质都处处蕴含着能量，也就是制衡的力量！</Dialog>
    			      <Button label="制衡的力量，难道是说风水？" nextID="-1" close="false">
    			        <Goto value="index_0_2"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_2" type="dialog">
    			    <Page id="0">
    				  <Dialog npcID="173800" npcName="伍兹">你也可以这么理解！制衡就是几种巨大的力量互相牵制，从而形成强大的保护力！来看看我的设计图吧！</Dialog>
    			      <Button label="好的。" nextID="-1" close="true">
    			        <Goto value="index_0_3"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_3" type="asWindow" src="task/2006/AboutFiveElements" winPos="0|0" name="关于五行">
    			    <Default>
    			      <Goto value="index_0_4"/>
    			    </Default>
    			  </Script>
    			  <Script label="index_0_4" type="dialog">
    			    <Page id="0">
    				  <Dialog npcID="173800" npcName="伍兹">现在懂了吗？只有得到了这三个代表不同力量的神器，这座魔法台才能发挥它最大的保护作用！</Dialog>
    			      <Button label="用小动物做神器，不太好吧。" nextID="-1" close="false">
    			        <Goto value="index_0_5"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_5" type="dialog">
    			    <Page id="0">
                    <Dialog npcID="173800" npcName="伍兹">你懂什么？如果没有这五行力量的保护，难道你不怕举行庆典的时候，恩佐突然降临？！</Dialog>
    			      <Button label="这……" nextID="-1" close="false">
    			        <Goto value="index_0_6"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_6" type="dialog">
    			    <Page id="0">
                    <Dialog npcID="173800" npcName="伍兹">别这这那那了，既然格里芬让你来帮我，那你就要服从我的命令！现在，我命令你，去海螺洞穴打败幽暗蘑菇，寻找定海珠！至于象牙和金钱豹子皮嘛……</Dialog>
    			      <Button label="这两个值钱的要怎么找呢？" nextID="-1" close="false">
    			        <Goto value="index_0_7"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_7" type="dialog">
    			    <Page id="0">
                    <Dialog npcID="173800" npcName="伍兹">这两个神器确实非常难找到，尤其是金钱豹，现在已经灭绝了！只有一个办法，才可能找到它们！</Dialog>
    			      <Button label="什么办法？让金钱豹复活？" nextID="-1" close="false">
    			        <Goto value="index_0_8"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Script label="index_0_8" type="dialog">
    			    <Page id="0">
                    <Dialog npcID="173800" npcName="伍兹">穿越，穿越到100年前，那时金钱豹还没有灭绝，大象也没有现在这么罕见！问格里芬借时光沙漏，应该可以回到过去！</Dialog>
    			      <Button label="好的！行动！" nextID="-1" close="true">
    			        <Goto value="index_0_9"/>
    			      </Button>
    			    </Page>
    			  </Script>
    			  <Click label="index_0_9" event="onTaskCall2" params="2|2006"/>
    			</Click>
    
    	</Npc>
