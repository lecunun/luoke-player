    <NPCFun sceneID="6" label="我们回来了！" icon="0" close="false">
    		<Click event="onRunScript">
    		  <Script label="default" type="dialog">
    		    <Page id="0">
                 <Dialog npcID="100100" npcName="格里芬">你们终于回来了！这次寻找神器还顺利吗？</Dialog>
    		      <Button label="将事情一五一十地告诉了院长……" nextID="-1" close="false">
    		        <Goto value="index_0_1"/>
    		      </Button>
    		    </Page>
    		  </Script>
    		  <Script label="index_0_1" type="dialog">
    		    <Page id="0">
                 <Dialog npcID="100100" npcName="格里芬">呵呵，原来是这样！我为你们感到骄傲，你们在利益面前放下了杀戮，挽救了整个族群！我会好好将这对小豹子抚养大，让它们能够继续繁衍下去！</Dialog>
    		      <Button label="可是，我们没有完成任务，神器……" nextID="-1" close="false">
    		        <Goto value="index_0_2"/>
    		      </Button>
    		    </Page>
    		  </Script>
    		  <Script label="index_0_2" type="dialog">
    		    <Page id="0">
                <Dialog npcID="100100" npcName="格里芬">呵呵，珍稀动物的骨头或是皮革确实具有巨大的魔力，但即便在我们的私欲面前，它们也是一条生命，生命重于一切！否则无论多么价值连城的神器，都将有可能带来毁灭性的灾难！</Dialog>
    		      <Button label="神器……神泣……，我明白了！" nextID="-1" close="false">
    		        <Goto value="index_0_3"/>
    		      </Button>
    		    </Page>
    		  </Script>
