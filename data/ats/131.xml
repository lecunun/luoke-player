    		  <Script label="default" type="dialog">
    		    <Page id="0">
    		      <Dialog npcID="100100" npcName="格里芬"><![CDATA[{name},你来的正好！下个月学院将举行开学典礼，盛典的场地就定在魔法台！]]></Dialog>
