  <Task id="3039" label="冰系精灵王出现！">
    <!-- npc_c0_xml · 场景 13 -->
    <Npc sceneID="13" type="1" npcID="214700" position="0|0" name="冰系精灵王">
            <View type="0" src="214700.swf" atLayerID="2" hasClick="false"/>
            <Create>
              <ViewEvent type="Getit_0_3039_214700">
