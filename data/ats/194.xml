                      <Dialog npcID="215600" npcName="冰系精灵王">哈哈哈哈，现在的小娃娃越来越不懂规矩了，替你家长辈教训教训你！</Dialog>
                      <Dialog npcID="210200" npcName="洛奇">我……我我我，接招，看我打败你！</Dialog>
                      <Button label="洛奇我来帮你！" nextID="-1" close="true">
                        <Goto value="index_2147006"/>
                      </Button>
                    </Page>
                  </Script>
                  <Script label="index_2147006" type="switch" invoke="combat" args="2|214700|冰系精灵王">
                    <Case value="2">
                      <END/>
                    </Case>
                    <Default>
                      <Goto value="index_2147007"/>
                    </Default>
                  </Script>
                  <Click label="index_2147007" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state_1_3039_214700_0"/>
                </Click>
              </ViewEvent>
              <ViewEvent type="Getit_2_3039_214700">
                <Click event="onRunScript">
                  <Script label="default" type="dialog">
                    <Page id="0">
                      <Dialog npcID="215600" npcName="冰系精灵王">（这个孩子的身上……圣剑……难道？）</Dialog>
                      <Dialog npcID="210200" npcName="洛奇">好厉害！镇长它到底是谁？</Dialog>
                      <Dialog npcID="205500" npcName="戴维镇长">它是冰系精灵王，曾经是亚瑟王的伙伴，他们一起封印了黑暗空间！</Dialog>
                      <Dialog npcID="205500" npcName="戴维镇长">冰系精灵王，为什么你会出现在这里？圣剑争夺战的时候你也出现了，难道是为了圣剑？</Dialog>
                      <Dialog npcID="215600" npcName="冰系精灵王">不错，我确实是为了圣剑而来！</Dialog>
                      <Button label="又一个要抢圣剑的？" nextID="-1" close="true">
                        <Goto value="index_21470014"/>
                      </Button>
                    </Page>
                  </Script>
                  
                   <Script label="index_21470014" type="asWindow" src="task/3039/3039_0" winPos="0|0" name="冰系精灵王">
                    <Default>
                      <Goto value="index_21470015"/>
                    </Default>
                    </Script>
         
                  <Script label="index_21470015" type="dialog">
                    <Page id="0">
                      <Dialog npcID="205500" npcName="戴维镇长">虽然你曾是亚瑟王的伙伴，但是圣剑关系重大，我不能借你。</Dialog>
                      <Dialog npcID="215600" npcName="冰系精灵王">我知道，所以只要带我去存放圣剑的地方就行，由你们一起保护，我也抢不走。</Dialog>
                      <Dialog npcID="210200" npcName="洛奇">镇长大叔，帮帮冰系精灵王吧！</Dialog>
                      <Button label="对，我们会一起保护圣剑的，镇长放心！" nextID="-1" close="false">
                        <Goto value="index_21470019"/>
                      </Button>
                    </Page>
                  </Script>
                  <Script label="index_21470019" type="dialog">
                    <Page id="0">
                      <Dialog npcID="205500" npcName="戴维镇长">这，好吧，但是你要答应我，只能待在锁链的外围。</Dialog>
                      <Dialog npcID="215600" npcName="冰系精灵王">可以，只要在圣剑周围，应该都有帮助。</Dialog>
                      <Dialog npcID="205500" npcName="戴维镇长">好，我们去枫雪教堂吧！</Dialog>
                      <Button label="好！" nextID="-1" close="true">
                        <Goto value="index_21470022"/>
                      </Button>
                    </Page>
                  </Script>
                  <Click label="index_21470022" event="NULL" fire="true"/>
                </Click>
              </ViewEvent>
            </Create>
          </Npc>
