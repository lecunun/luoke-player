  <Task id="1035" label="布下迷魂阵">
    <!-- npc_t3_xml · 场景 89 -->
    <Npc sceneID="89" type="1" npcID="130000" position="385|346" name="帕尔萨斯">
    	<View type="0" src="130000.swf" atLayerID="2"/>
    	<Create>
    		<NPCFun label="守卫古堡" icon="0">
    			<Click event="onRunScript">
    			<Script type="switch" label="default">
    				<Func invoke="taskIsComplete" args="1035"/>
    				<Case value="0">
    					<Script label="default" type="dialog">
    						<Page>
    							<Dialog npcID="130000" npcName="帕尔萨斯">在古堡花园合成石像鬼，正好可以抵御黑衣人的入侵！</Dialog>
    							<Button label="我知道啦！" close="true"><End/></Button>
    						</Page>
    					</Script>
    				</Case>
    				<Case value="1">
    					<Click event="onRunScript">
    							<Script label="default" type="dialog">
    								<Page id="0">
    									<Dialog npcID="130000" npcName="帕尔萨斯">你来得正是时候，快看，月黑风高，乌云遮月，怕是不久，恩佐一行人就要来夺取永生之血了。</Dialog>
    									<Button label="成败在此一举" nextID="-1">
    										<Goto value="dialog_1"/>
    									</Button>
    								</Page>
    							</Script>
    							<Script label="dialog_1" type="dialog">
    								<Page id="1">
    									<Dialog npcID="130000" npcName="帕尔萨斯">雾气如此之重，不如你快去古堡露台点燃南瓜灯，照亮庭院吧！这样石像鬼才能看得足够清楚！</Dialog>
    									<Button label="好的" close="true" nextID="-1">
    										<Goto value="submit"/>
    									</Button>
    								</Page>
    							</Script>
    							<Click label="submit" event="onTaskCall2" params="2|1035"/>
    					</Click>
    				</Case>
    			</Script>
    			</Click>
    			</NPCFun>;
    	</Create>
    	<Click event="onTaskCall" cdtn="50"/>
    </Npc>
