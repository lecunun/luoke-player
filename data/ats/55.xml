  <Task id="1036" label="大决战">
    <!-- npc_t4_c0_xml · 场景 92 -->
    <Npc sceneID="92" type="1" npcID="130900" position="0|0">
    		<View type="0" src="130900.swf" atLayerID="1" hasClick="false"/>
    		<Create>
    		<ViewEvent type="SHOW_POERSAS">
    			<Click event="onRunScript" cdtn="50">
    			<Script label="default" type="dialog">
    					<Page>
    						<Dialog npcID="130000" npcName="帕尔萨斯">他们已经来了！真是来势汹汹啊！看来成败在此一举！</Dialog>
    						<Button label="但愿石像鬼能抵挡住他们！" close="true" nextID="-1">
    							<Goto value="win_0"/>
    						</Button>
    					</Page>
    			</Script>
    				
    			<Script type="asWindow" src="task\1036\1036_0" winPos="0|0" name="守卫古堡动画" label="win_0">
    				<Default><Goto value="dialog_2"/></Default>
    			</Script>
    	
    			<Script label="dialog_2" type="dialog">
    					<Page>
    						<Dialog npcID="130000" npcName="帕尔萨斯">太好了！恩佐一行人的进攻都被抵御住了！</Dialog>
    						<Button label="快看，那边好像有个黑影" close="true" nextID="-1">
    							<Click event="NULL" fire="true"/>
    						</Button>
    					</Page>
    			</Script>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="SHOW_DIALOG">
    			<Click event="onRunScript" cdtn="50">
    			
    			<Script label="default" type="dialog">
    					<Page>
    						<Dialog npcID="130900" npcName="黑衣人">哼哼！没想到我竟然能进来吧！看来恩佐的这招声东击西，还是挺管用的！你们最好识相点，把永生之血乖乖地给我交出来吧！</Dialog>
    						<Button label="你这是自投罗网" close="true" nextID="-1">
    							<Goto value="combat"/>
    						</Button>
    					</Page>
    			</Script>
    				
    			<Script type="switch" invoke="combat" args="2|130900|黑衣人" label="combat">
    			<Case value="2"><Goto value="dialog_2"/></Case>
    			</Script>
    	
    			<Script label="dialog_2" type="dialog">
    				<Page>
    						<Dialog npcID="130900" npcName="黑衣人">哼哼！你以为真的结束了么？这简直是不可能的！我们还会再卷土重来的！</Dialog>
    						<Button label="有本事你别逃" close="true" nextID="-1">
    							<Click event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state4"/>
    						</Button>
    				</Page>
    			</Script>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="SHOW_DIALOG2">
    			<Click event="onRunScript" cdtn="50">
    			<Script label="default" type="dialog">
    					<Page>
    						<Dialog npcID="130000" npcName="帕尔萨斯">快看！黑衣人飞过来了！他是怎么来到这里的！</Dialog>
    						<Button label="别担心，还有我在" close="true" nextID="-1">
    							<End/>
    						</Button>
    					</Page>
    			</Script>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="LEAVE_NPC">
    			<Click event="onRunScript" cdtn="50">
    			
    			<Script label="default" type="dialog">
    					<Page>
    						<Dialog npcID="130000" npcName="帕尔萨斯">真是太好了，按照德古拉伯爵的布阵，果然有效地阻止了恩佐一行人</Dialog>
    						<Button label="德古拉伯爵现在在哪里？" nextID="-1">
    							<Goto value="dialog_2"/>
    						</Button>
    					</Page>
    			</Script>
    	
    			<Script label="dialog_2" type="dialog">
    				<Page>
    						<Dialog npcID="130000" npcName="帕尔萨斯">其实……这是一个不能说的秘密……不过我还是很感谢你。现在，危机解除了，我要继续在古堡里修行了。如果你和德古拉有缘的话，自然会相见的。</Dialog>
    						<Button label="这是我应该做的" close="true" nextID="-1">
    							<Click event="onTaskCall2" params="2|1036"/>
    						</Button>
    				</Page>
    			</Script>
    			</Click>
    		</ViewEvent>
    		</Create>
    	</Npc>
