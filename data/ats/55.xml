<Story id="55" label="守卫古堡">
  <Task id="1033" label="帮助帕尔萨斯">
    <!-- npc_t1_xml · 场景 89 -->
    <Npc sceneID="89" type="1" npcID="130000" position="385|346" name="帕尔萨斯">
    <View type="0" src="130000.swf" atLayerID="2"/>
    <Create>
    	<NPCFun label="守卫古堡" icon="-1">
    			<Click event="onRunScript">
    				
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="130000" npcName="帕尔萨斯">啊，<![CDATA[{name}]]>，你是我们这么多年唯一的朋友，我需要你的帮助！又到了每年的万圣节，真是大事不好了！</Dialog>
    						<Button label="究竟发生什么事情了？" nextID="-1">
    							<Goto value="dialog_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_1" type="dialog">
    					<Page id="1">
    						<Dialog npcID="130000" npcName="帕尔萨斯">其实，每年的万圣节期间，恩佐都会来城堡夺取永生之血。</Dialog>
    						<Button label="什么是永生之血？" close="true" nextID="-1">
    							<Goto value="window_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script type="asWindow" src="task\1033\1033_0" name="永生之血" label="window_1">
    				<Default><Goto value="dialog_2"/></Default>
    				</Script>
    		
    				<Script label="dialog_2" type="dialog">
    					<Page id="0">
    						<Dialog npcID="130000" npcName="帕尔萨斯">其实永生之血并不存在，但是恩佐并不知道此事。他现在又要来进攻古堡，寻找永生之血！可是，他怎么可能找得到呢？请你一定要帮帮我！</Dialog>
    						<Button label="定将不负所托" nextID="-1">
    							<Goto value="dialog_3"/>
    						</Button>
    					</Page>
    				</Script>
    		
    				<Script label="dialog_3" type="dialog">
    					<Page id="0">
    						<Dialog npcID="130000" npcName="帕尔萨斯">其实当年德古拉伯爵，为了防止坏人来这里，已经有一套排兵布阵的方法，但是需要石像鬼才行。可是只有收集了特殊的材料，才能合成石像鬼。</Dialog>
    						<Button label="什么是特殊的材料" nextID="-1">
    							<Goto value="dialog_4"/>
    						</Button>
    					</Page>
    				</Script>
    		
    				<Script label="dialog_4" type="dialog">
    					<Page id="0">
    						<Dialog npcID="130000" npcName="帕尔萨斯">它们就存在于这座古堡之中，你只要按照我的指引去寻找，就一定会找到！如果你做好准备了，我们就开始寻找之旅吧！</Dialog>
    						<Button label="我准备好了" close="true">
    							<Goto value="submit"/>
    						</Button>
    					</Page>
    				</Script>
    		
    				<Click label="submit" event="onTaskCall2" params="2|1033"/>
    			</Click>
    			</NPCFun>
    </Create>
    <Click event="onTaskCall" cdtn="50"/>
    </Npc>
  </Task>
  <Task id="1034" label="收集材料">
    <!-- npc_t2_xml · 场景 89 -->
    <Npc sceneID="89" type="1" npcID="130000" position="385|346" name="帕尔萨斯">
    	<View type="0" src="130000.swf" atLayerID="2"/>
    	<Create>
    		<NPCFun label="守卫古堡" icon="0">
    			<Click event="onRunScript">
    			<Script type="switch" label="default">
    				<Func invoke="taskIsComplete" args="1034"/>
    				<Case value="0">
    					<Script label="default" type="dialog">
    						<Page>
    							<Dialog npcID="130000" npcName="帕尔萨斯">花园十字架里有一个卷轴，卷轴上记录着所需材料的地点。只有找到那些材料，才能合成石像鬼。</Dialog>
    							<Button label="我知道啦！" close="true"><End/></Button>
    						</Page>
    					</Script>
    				</Case>
    				<Case value="1">
    					<Click event="onRunScript">
    					<Script label="default" type="dialog">
    						<Page id="0">
    							<Dialog npcID="130000" npcName="帕尔萨斯">看来我果然没有看错你。既然已经有了足够的材料，现在就要开始准备用这些材料去合成石像鬼了！</Dialog>
    							<Button label="怎么合成石像鬼" nextID="-1">
    								<Goto value="dialog_1"/>
    							</Button>
    						</Page>
    					</Script>
    					<Script label="dialog_1" type="dialog">
    						<Page id="1">
    							<Dialog npcID="130000" npcName="帕尔萨斯">实际上，合成石像鬼的魔法卷轴，就在内厅的德古拉伯爵的画像里！你去看看就知道啦！</Dialog>
    							<Button label="我知道了" close="true" nextID="-1">
    								<Goto value="submit"/>
    							</Button>
    						</Page>
    					</Script>
    					<Click label="submit" event="onTaskCall2" params="2|1034"/>
    					</Click>
    				</Case>
    			</Script>
    			</Click>
    		</NPCFun>
    	</Create>
    	<Click event="onTaskCall" cdtn="50"/>
    </Npc>
