  <Task id="119" label="雪人谷幻影">
    <!-- npcfun_100100 · 场景 6 -->
    <NPCFun sceneID="6" label="奇怪的幻影" icon="-1" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="100100" npcName="格里芬">恩佐又来了……</Dialog>
                    <Button label="什么？" nextID="-1">
                        <Goto value="dialog_1"/>
                    </Button>
                </Page>
            </Script>
            <Script label="dialog_1" type="dialog">
                <Page id="0">
                    <Dialog npcID="100100" npcName="格里芬">在雪人谷出现了很多幻影，恐怕是恩佐新的阴谋。此行的危险我没有办法估量，你是否愿意帮助王国，到雪人谷调查一下呢？</Dialog>
                    <Button label="当然愿意！" nextID="-1" close="true">
                        <Goto value="submit"/>
                    </Button>
                    <Button label="考虑一下……" nextID="-1" close="true"/>
                </Page>
            </Script>
            <Click label="submit" event="onTaskCall2" params="1|119"/>
        </Click>
    </NPCFun>
    <!-- npc_138900 · 场景 100 -->
    <Npc sceneID="100" type="1" npcID="138900" position="600|400">
        <View type="0" src="138900.swf" atLayerID="1" hasClick="false"/>
