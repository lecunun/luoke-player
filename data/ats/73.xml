                    <Script label="default" type="switch" invoke="combat" args="2|138900|幻影">
                        <Case value="2"><Goto value="win"/></Case>
                        <Default><End/></Default>
                    </Script>
                    <Click label="win" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="task_119_npc_138900_fight_win"/>
                </Click>
            </ViewEvent>
            <ViewEvent type="task_119_npc_138900_over">
                <Click event="NULL" fire="true"/>
            </ViewEvent>
        </Create>
    </Npc>
