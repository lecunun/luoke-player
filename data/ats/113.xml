      <Script label="index_0_3" type="dialog">
        <Page id="0">
          <Dialog npcID="163000" npcName="山姆大叔">我感到很孤单，所以，我培养了一朵玫瑰。</Dialog>
          <Button label="玫瑰很普通啊~" nextID="-1" close="false">
            <Goto value="index_0_4"/>
          </Button>
        </Page>
      </Script>
