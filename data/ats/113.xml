          <Button label="这不是你的错……" nextID="-1" close="false">
            <Goto value="index_0_7"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_7" type="dialog">
        <Page id="0">
          <Dialog npcID="163000" npcName="山姆大叔">陈年旧事，不提也罢……倒是莎莉，这么久还没有回来……是不是电狐对她不利了……我还要在这里照顾小地鼠。</Dialog>
