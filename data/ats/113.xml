    <NPCFun sceneID="128" label="电狐怎么了？" icon="0" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="163000" npcName="山姆大叔">它是我以前的宠物。</Dialog>
          <Button label="那现在呢？" nextID="-1" close="false">
            <Goto value="index_0_1"/>
