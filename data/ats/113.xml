        <Default>
          <Goto value="index_0_6"/>
        </Default>
      </Script>
      <Script label="index_0_6" type="dialog">
        <Page id="0">
          <Dialog npcID="163000" npcName="山姆大叔">我很用心培养，但是玫瑰对我却不瞅不睬。我一下子对种植绝望了……为什么会这样子呢……</Dialog>
