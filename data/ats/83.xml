  <Task id="1064" label="打草惊蛇">
    <!-- npc_c0_xml · 场景 103 -->
    <Npc sceneID="103" type="1" npcID="146800" position="308|339">
    	<View type="0" src="146800.swf" atLayerID="2" hasClick="false"/>
    	<Create>
    		<ViewEvent type="GotIt0_1064_146800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">这里怎么可能异常安静？实在太奇怪了！恩佐怎么可能不知道我们来了呢？</Dialog>
    						<Dialog npcID="146600" npcName="圣安德鲁国王">定要当心！想必他们早有埋伏！</Dialog>
    						<Button label="硬往里闯，岂不是中了埋伏？" nextID="-1">
    							<Goto value="dialog_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_1" type="dialog">
    					<Page id="0">
    						<Dialog npcID="144800" npcName="仙灵独角兽">我可以飞，不如我前去探察一番！</Dialog>
    						<Dialog npcID="146600" npcName="圣安德鲁国王">恩！也只有这样了！</Dialog>
    						<Button label="独角兽……你一定要当心！" nextID="-1" close="true">
    							<Goto value="asWindow_0"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_0" type="asWindow" src="task/1064/1064_0" winPos="0|0" name="提示">
    					<Default><Goto value="submit"/></Default>
    				</Script>
    				<Click label="submit" event="NULL" fire="true"/>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="GotIt1_1064_146800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="144800" npcName="仙灵独角兽">果然如陛下所言！他们早有埋伏！</Dialog>
    						<Dialog npcID="141200" npcName="呱呱">哼！我就料到！一定不能中了他们的奸计！</Dialog>
    						<Button label="难道我们坐以待毙么？" nextID="-1">
    							<Goto value="dialog_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_1" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">当然不行！让我想想……啊！我有办法了！</Dialog>
    						<Button label="啊？什么办法？" nextID="-1" close="true">
    							<Goto value="asWindow_0"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_0" type="asWindow" src="task/1064/1064_1" winPos="0|0" name="提示">
    					<Default><Goto value="dialog_2"/></Default>
    				</Script>
    				<Script label="dialog_2" type="dialog">
    					<Page id="0">
    						<Dialog npcID="146600" npcName="圣安德鲁国王">这的确是个妙计！但是你怎么能断定，那条小路没有设下埋伏呢？</Dialog>						
    						<Dialog npcID="141200" npcName="呱呱">只要让先头部队先去假装攻打，趁乱之时，让他们自己把埋伏的地点暴露出来，我们看看那条小路到底有没有设下埋伏就知道了！</Dialog>
    						<Dialog npcID="128700" npcName="阿基拉">不如我去吧！我有喷射器，可以飞行！</Dialog>					
    						<Dialog npcID="128800" npcName="龙族之王">我也可以飞，阿基拉，你独自去太危险了，我们一起去吧！</Dialog>
    						<Dialog npcID="128700" npcName="阿基拉">看来我和龙族之王真是英雄惜英雄啊！</Dialog>
    						<Button label="我也要去！" nextID="-1" close="true">
    							<Goto value="asWindow_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="asWindow_1" type="asWindow" src="task/1064/1064_2" winPos="0|0" name="提示">
    					<Default><Goto value="submit"/></Default>
    				</Script>
    				<Click label="submit" event="NULL" fire="true" fireID="147000"/>
    			</Click>
    		</ViewEvent>
    		<ViewEvent type="GotIt2_1064_146800">
    			<Click event="onRunScript">
    				<Script label="default" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱"><![CDATA[{name}]]>，辛苦你了！果然小路没有敌军埋伏！不知你是否愿意随我一起，悄悄从小路走，去救出公主！</Dialog>
    						<Button label="呱呱！你果然好聪明啊！" nextID="-1">
    							<Goto value="dialog_1"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_1" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱">这是玄玉岛古老的兵法，三十六计之一的打草惊蛇！</Dialog>
    						<Dialog npcID="146600" npcName="圣安德鲁国王">呱呱！我就命你带一路人马，从小路进攻！</Dialog>
    						<Dialog npcID="135000" npcName="西格">请带我一起去吧！</Dialog>
    						<Dialog npcID="135600" npcName="蔷薇骑士">也请让我一同去吧！</Dialog>
    						<Dialog npcID="132700" npcName="帕娃咔咔">我也要去！我也要去！</Dialog>
    						<Dialog npcID="133500" npcName="八字毛球">还有我！还有我！</Dialog>
    						<Button label="呱呱！我不怕死！" nextID="-1">
    							<Goto value="dialog_2"/>
    						</Button>
    					</Page>
    				</Script>
    				<Script label="dialog_2" type="dialog">
    					<Page id="0">
    						<Dialog npcID="141200" npcName="呱呱"><![CDATA[{name}]]>，西格，帕娃咔咔和八字毛球与我一路。蔷薇骑士的土鳖有遁地术，以后定有用处，要留下保护国王！</Dialog>
    						<Dialog npcID="135600" npcName="蔷薇骑士">好！我一定会好好保护国王陛下的！</Dialog>
    						<Button label="迷魂八卦的埋伏众多，如何去小路？" nextID="-1" close="true">
    							<Goto value="submit"/>
    						</Button>
    					</Page>
    				</Script>
    				<Click label="submit" event="onTaskCall2" params="2|1064"/>
    			</Click>
    		</ViewEvent>
