<Story id="92" label="冰释前嫌">
  <Task id="1069" label="玄玉岛的小独角兽">
    <!-- npcfun_g_xml · 场景 113 -->
    <NPCFun sceneID="113" label="冰释前嫌" icon="-1" close="false">
    		<Click event="onRunScript" cdtn="60">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="145100" npcName="熙铭将军"><![CDATA[{name}]]>，你是从西方来的，应该会一些西方的魔法吧？</Dialog>
    				<Button label="恩，不过我还没有学有所成" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="145100" npcName="熙铭将军">实际上，玄玉岛有一只宠物生病了，可能只有西方的魔法才能救治它，所以才找你来帮忙。</Dialog>
    				<Button label="定不负所托！不过是什么宠物？这么奇怪？" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="145100" npcName="熙铭将军">其实……是一只小独角兽……</Dialog>
    				<Button label="独角兽？怎么会在玄玉岛出现？" nextID="-1">
    					<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="145100" npcName="熙铭将军">具体的，你去画中仙里面，问问被封印的年兽就知道了。</Dialog>
    				<Button label="画中仙在哪里？" nextID="-1">
    					<Goto value="dialog_5"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_5" type="dialog">
    			<Page id="0">
    				<Dialog npcID="145100" npcName="熙铭将军">就是玉和殿的那幅画卷里面。</Dialog>
    				<Button label="好的" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="1|1069"/>
    		</Click>
    	</NPCFun>
    <!-- npc_p_xml · 场景 114 -->
    <Npc sceneID="114" type="1" npcID="153600" position="593|324">
    		<View type="0" src="153600.swf" atLayerID="2" hasClick="false"/>
    		<Create>
    		<ViewEvent type="GotIt0_1069_153600">
    		<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽"><![CDATA[{name}]]>……你来这里干什么？</Dialog>
    				<Button label="熙铭将军说有独角兽生病了，让我来找你。" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">既然是熙铭将军让你来找我的，说明你是靠得住的人啊。</Dialog>
    				<Button label="玄玉岛怎么会有独角兽？" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">是啊……玄玉岛怎么可能有独角兽？独角兽该在洛克王国的独角仙踪长大啊。</Dialog>
    				<Button label="可是熙铭将军说……" nextID="-1">
    					<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">你看，那是什么？</Dialog>
    				<Button label="哪里？" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state0_1069_153600"/>
    		</Click>
    		</ViewEvent>
    		<ViewEvent type="GotIt1_1069_153600">
    		<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">你说它是不是独角兽？</Dialog>
    				<Button label="长着翅膀的独角兽！第一次看见！" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">可是现在它不能飞了。我想，可能是它水土不服的缘故。</Dialog>
    				<Button label="你怎么得来这只独角兽的？" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1069/1069_0" winPos="0|0" name="提示">
    			<Default><Goto value="submit"/></Default>
    		</Script>
    		<Click label="submit" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state1_1069_153600"/>
    		</Click>
    		</ViewEvent>
    		<ViewEvent type="GotIt2_1069_153600">
    		<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽"><![CDATA[{name}]]>，我的小独角兽，它以前可以飞的，但是最近，身体每况愈下，现在连飞都飞不起来了……就连熙铭大将军都不知道是怎么回事……你可以救它吗？</Dialog>
    				<Button label="我实在没有这个能力……" nextID="-1">
    					<Goto value="dialog_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_1" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">唉……我估计只有独角仙踪的独角兽可以救它了。我从来不求人的，不过这次，你可以帮我去问问它，究竟该怎么办么？</Dialog>
    				<Button label="好！" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">对了……千万不要说，是我让你来的……</Dialog>
    				<Button label="……为什么？" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">你不需要知道那么多……</Dialog>
    				<Button label="好吧……" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="2|1069"/>
    		</Click>
    		</ViewEvent>
    		</Create>
    	</Npc>
