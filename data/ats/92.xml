  </Task>
  <Task id="1070" label="冷漠的独角兽">
    <!-- npcfun_c0_xml · 场景 111 -->
    <NPCFun sceneID="111" label="冰释前嫌" icon="0" close="false">
    		<Click event="onRunScript" cdtn="60" hasClick="false">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽"><![CDATA[{name}]]>，你来找我，肯定是无事不登三宝殿吧。</Dialog>
    				<Button label="……其实是有一只小独角兽需要你帮忙。" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">哦？有需要我帮忙的独角兽？我怎么不知道。只要是这幼果上成长的独角兽，都和我有心灵感应，需要我帮忙的话，我立刻感应得到。</Dialog>
    				<Button label="它……可能不是这里长出的。" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">那它就不是独角兽。所有独角兽，都是在这里生长的！</Dialog>
    				<Button label="它是独角兽！可是它水土不服！翅膀飞不起来了！" nextID="-1">
    					<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">翅膀……？你说它有翅膀？</Dialog>
    				<Button label="是啊！对了，为什么你没有翅膀？" nextID="-1">
    					<Goto value="dialog_5"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_5" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">啊……那真是提起来就让我又悲又恨啊……</Dialog>
    				<Button label="可以告诉我吗？" nextID="-1">
    					<Goto value="dialog_5_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_5_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">那是很久很久以前的事情了……那个时候，我和年兽学成出山，都在玄玉岛为现在平阳公主的奶奶，也就是平月公主效命。我永远也忘不了那一天……</Dialog>
    				<Button label="恩……洗耳恭听……" nextID="-1" close="true">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1070/1070_0" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_6"/></Default>
    		</Script>
    		<Script label="dialog_6" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">所以，我后来培育的那些独角兽，都没有翅膀了……因为我不想它们也受和我一样的痛苦。这也是为什么，我和年兽结下梁子的原因。</Dialog>
    				<Button label="原来如此……你不打算救救那只独角兽么？" nextID="-1">
    					<Goto value="dialog_7"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_7" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">我说过了，从来就没有有翅膀的独角兽！除非你去证明给我看！</Dialog>
    				<Button label="好吧……" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="NULL" fire="true" fireID="144802"/>
    		</Click>
    	</NPCFun>
    <!-- npc_c1_xml · 场景 111 -->
    <Npc sceneID="111" type="1" npcID="153600" position="593|324">
    		<View type="0" src="153600.swf" atLayerID="2" hasClick="false"/>
    		<Create>
    		<ViewEvent type="GotIt0_1070_153600">
    		<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">看来独角兽还是那样固执啊……</Dialog>
    				<Button label="独角兽说是你折断了它的翅膀。" nextID="-1">
    					<Goto value="dialog_2"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">看来它还记得啊……</Dialog>
    				<Button label="原来这是真的……！！" nextID="-1">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1070/1070_1" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_3"/></Default>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">不过已经过了这么多年……唉……只要独角兽可以救救它，我做什么都可以。</Dialog>
    				<Button label="独角兽要我证明，这只小独角兽真的有翅膀才行。" nextID="-1">
    					<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">既然如此……那就让小独角兽把翅膀上的羽毛给你，你带过去给它看看就知道了。</Dialog>
    				<Button label="这样就可以了吗？" nextID="-1">
    					<Goto value="dialog_5"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_5" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">我想是的……毕竟这片羽毛上，承载了小独角兽的记忆，独角兽看了就会明白的。到时候请你务必让它来此处。</Dialog>
    				<Button label="我不能和小独角兽一起去独角仙踪么？" nextID="-1">
    					<Goto value="dialog_6"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_6" type="dialog">
    			<Page id="0">
    				<Dialog npcID="153600" npcName="年兽">你有所不知，小独角兽自出生来从未离开过玄玉岛，加之现在魔法能力又很弱……</Dialog>
    				<Button label="好！我一定把独角兽请来此处！" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="NULL" fire="true"/>
    		</Click>
    		</ViewEvent>
    		</Create>
    	</Npc>
    <!-- npcfun_p_xml · 场景 111 -->
    <NPCFun sceneID="111" label="冰释前嫌" icon="0" close="false">
    		<Click event="onRunScript" cdtn="60">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">啊！这的确是……</Dialog>
    				<Button label="它应该和你有某种关系吧……" nextID="-1">
    					<Goto value="asWindow_0"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_0" type="asWindow" src="task/1070/1070_2" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_2"/></Default>
    		</Script>
    		<Script label="dialog_2" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">不过……真的是年兽一直帮我养育着它吗……？</Dialog>
    				<Button label="对的！" nextID="-1">
    					<Goto value="dialog_3"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_3" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">哼，难道不是它的阴谋么？</Dialog>
    				<Button label="为何你就不能相信它会改邪归正呢？" nextID="-1">
    					<Goto value="dialog_4"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_4" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">唉……我很担心，这是它让我过去，想让我教它西方魔法的阴谋啊。以前，他多次向我讨教魔法的学习之道，我明明已经告诉了他，可他就是怀恨在心。</Dialog>
    				<Button label="什么意思？" nextID="-1" close="true">
    					<Goto value="asWindow_1"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="asWindow_1" type="asWindow" src="task/1070/1070_3" winPos="0|0" name="提示">
    			<Default><Goto value="dialog_5"/></Default>
    		</Script>
    		<Script label="dialog_5" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">它一而再，再而三地陷害我，我怎能对它毫无防范？</Dialog>
    				<Button label="这次你见到了翅膀，请你相信我！" nextID="-1">
    					<Goto value="dialog_6"/>
    				</Button>
    			</Page>
    		</Script>
    		<Script label="dialog_6" type="dialog">
    			<Page id="0">
    				<Dialog npcID="144800" npcName="仙灵独角兽">	好吧……这次就相信你……</Dialog>
    				<Button label="那现在我们就去画中仙吧！" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="2|1070"/>
    		</Click>
    	</NPCFun>
