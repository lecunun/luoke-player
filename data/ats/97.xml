    <Npc type="1" npcID="140500" position="592|391" aimPos="592|391" name="仙鹤族长">
    		<View type="0" src="140500.swf" atLayerID="1"/>
    		<Create>
               <NPCFun label="需要水灵花和仙药" icon="0" close="false">
                  <Click event="onRunScript" cdtn="60">
    			<Script label="default" type="switch">
    				<Func invoke="taskIsComplete" args="4021"/>
    				<Case value="0"><Goto value="notOK"/></Case>
    				<Case value="1"><Goto value="ok"/></Case>
    			</Script>
    			<Script label="notOK" type="dialog">
    				<Page id="0">
    					<Dialog npcID="140500" npcName="仙鹤族长">云海古道的水灵花，云烟桃源的仙药，想想缺少哪个呢？</Dialog>
    					<Button label="好的，我继续找！" nextID="-1" close="true"/>
    				</Page>
    			</Script>
    			<Script label="ok" type="dialog">
    				<Page id="0">
    					<Dialog npcID="140500" npcName="仙鹤族长">感谢你的帮助，在你的帮助下我已经好多了。你让我相信，你是一个勇敢的洛克，你一定能有一番成就，我们族里的小仙鹤有点不服气，想和你较量一下，你愿意吗？</Dialog>
    					<Button label="好的" nextID="-1" close="true">
    						<Goto value="fight"/>
    					</Button>
                      <Button label="我准备下" nextID="-1" close="true">
                         <End/>
    					</Button>
    				</Page>
    			</Script>
               <Script label="fight" type="switch" invoke="combat" args="2|140500|仙鹤族长">
    				        <Case value="2"><Goto value="wined"/></Case>
    				        <Default><Goto value="losted"/></Default>
    	       </Script>
              <Script label="losted" type="dialog">
    				<Page id="0">
    					<Dialog npcID="140500" npcName="仙鹤族长">小仙鹤觉得你没有想象中的那么强大，努力提升自己吧，等到你强大了再来挑战它。</Dialog>
    					<Button label="好的" nextID="-1" close="true">
                           <End/>
    					</Button>
    				</Page>
    			</Script>
               <Script label="wined" type="dialog">
    				<Page id="0">
    					<Dialog npcID="140500" npcName="仙鹤族长">嗯，你真的很强大，很佩服你。我收集的这个果儿糖给你。</Dialog>
    					<Button label="好的" nextID="-1" close="true">
