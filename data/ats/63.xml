    	<Click event="onRunScript">
    		<Script label="default" type="dialog">
    			<Page id="0">
    				<Dialog npcID="122100" npcName="安格">感恩节是感谢他人的日子。这天的习俗是品尝以火鸡为主的感恩节美食。今年的烤火鸡订单太多了，我已经忙不过来了，你能帮我去火山弄一些烤火鸡的材料来么?我会给你丰厚的报酬。</Dialog>
    				<Button label="马上就去" nextID="-1" close="true">
    					<Goto value="submit"/>
    				</Button>
    				<Button label="一会再说" close="true">
    					<End/>
    				</Button>
    			</Page>
    		</Script>
    		<Click label="submit" event="onTaskCall2" params="1|3021"/>
    	</Click>
    	</NPCFun>
    <!-- npcfun_p_xml · 场景 87 -->
    <NPCFun sceneID="87" label="感恩节火鸡" icon="0" close="false">
    		<Click event="onRunScript">
    			<Script type="switch" label="default">
    				<Func invoke="taskIsComplete" args="3021"/>
    					<Case value="0">
    						<Script type="dialog">
    							<Page>
    									<Dialog npcID="122100" npcName="安格">感恩节就要来临了，可是烤火鸡的原料还远远不够，拜托你了。</Dialog>
    									<Button label="知道了" close="true">
    										<End/>
    									</Button>
    								</Page>
    							</Script>
    						</Case>
    						<Case value="1">
    							<Script type="dialog">
    								<Page>
    									<Dialog npcID="122100" npcName="安格">非常感谢你的帮忙，这是你的报酬。我这里还提供烤火鸡的打工机会，如果你有兴趣也非常欢迎。</Dialog>
    									<Button label="不客气" close="true">
    										<Click event="onTaskCall2" params="2|3021"/>
    									</Button>
    								</Page>
    							</Script>
    						</Case>
    					</Script>
