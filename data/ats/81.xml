<!-- 由 MakeRecipe.ats 还原；场景归属取自 21_TaskList.xml 的任务链 -->
<Story id="81" label="研磨药材">
  <Task id="4010" label="研磨药材">
    <!-- npcfun_122100 · 场景 87 -->
    <NPCFun sceneID="87" label="研磨药材" icon="-1" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="122100" npcName="安格">国王病了，我们有很多药材要碾成粉末，你能帮我找下材料吗，我们一起做个加工的工具吧。</Dialog>
                    <Button label="好的" nextID="-1" close="true">
                        <Goto value="accpet"/>
                    </Button>
                    <Button label="考虑一下" nextID="-1" close="true"/>
                </Page>
            </Script>
            <Click label="accpet" event="onTaskCall2" params="1|4010"/>
        </Click>
    </NPCFun>
    <!-- npcfun_109700 · 场景 43 -->
    <NPCFun sceneID="43" label="加工药材的工具" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="109700" npcName="托比">哦，安格让你来的，看来你是找对人啦，给你这个大石头，用来做加工的工具吧。</Dialog>
                    <Button label="好的" nextID="-1" close="true">
                        <Goto value="conditionOneUpdate"/>
                    </Button>
                </Page>
            </Script>
            <Click label="conditionOneUpdate" event="NULL" fire="true"/>
        </Click>
    </NPCFun>
    <!-- npcfun_102200 · 场景 1 -->
    <NPCFun sceneID="1" label="加工药材的工具" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="102200" npcName="万事通">你要找的这个东西我还真能帮你做，什么事能难倒我万事通？这个给你。</Dialog>
                    <Button label="好的" nextID="-1" close="true">
                        <Goto value="conditionTwoUpdate"/>
                    </Button>
                </Page>
            </Script>
            <Click label="conditionTwoUpdate" event="NULL" fire="true"/>
        </Click>
    </NPCFun>
    <!-- npcfun_122100_submit · 场景 87 -->
    <NPCFun sceneID="87" label="开始研磨药材" icon="0" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="122100" npcName="安格">看来还真的不错哦。这些工具可以了，都感谢他们了吧。好吧，我们研磨下药材试试。</Dialog>
                    <Button label="好的" nextID="-1" close="true">
                        <Goto value="playWorkingAnimation"/>
                    </Button>
                    <Button label="考虑一下" nextID="-1" close="true"/>
                </Page>
            </Script>
            <Script label="playWorkingAnimation" type="asWindow" src="task/4010/task_4010_workingAnimation" winPos="260|250" name="研磨药材">
                <Default><Goto value="submit"/></Default>
            </Script>
            <Click label="submit" event="onTaskCall2" params="2|4010"/>
        </Click>
    </NPCFun>
    <!-- npcfun_122100_canNotSubmit · 场景 87 -->
    <NPCFun sceneID="87" label="研磨药材的工具在哪里？" close="false">
        <Click event="onRunScript">
            <Script label="default" type="dialog">
                <Page id="0">
                    <Dialog npcID="122100" npcName="安格">问问矿洞的托比和商店街的万事通，看看他们有没有什么线索。</Dialog>
                    <Button label="好的" nextID="-1" close="true"/>
                </Page>
            </Script>
        </Click>
    </NPCFun>
  </Task>
</Story>
