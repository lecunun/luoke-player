<Story id="147" label="亚特族的觉醒">
  <Task id="2012" label="乐乐怎么了？">
    <!-- npcfun_0_xml · 场景 38 -->
    <NPCFun sceneID="38" label="乐乐你怎么了？" icon="-1" close="false">
    <Click event="onRunScript">
    
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="109900" npcName="乐乐">我很担心，在亚特兰蒂斯城内，已经有越来越多的亚特族人被恩佐奴役，这个趋势还在继续，一座古老的文明古城就要这样被毁了吗?</Dialog>
          <Button label="我们一定要阻止这个趋势啊！" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      
       <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="109900" npcName="乐乐">现在亚特族人都陷在贪念、欲望、征服异族的心魔里无法自拔，这都是恩佐使的坏！也许只有亚特族长老才能唤醒他们的意识了！</Dialog>
          <Button label="长老在哪？我去找他！" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      
       <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="109900" npcName="乐乐">长老……听说长老已经被恩佐关押起来了。不过，我们一定要寻找机会，你现在去亚特兰蒂斯城寻找长老的下落。</Dialog>
          <Dialog npcID="109900" npcName="乐乐">你需要打探下守卫的情况，完了回来我们商量下一步计划。</Dialog>
          <Button label="好，我现在去打探情况。" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      
       <Click label="index_0_3" event="onTaskCall2" params="1|2012"/>
      
    </Click>
    </NPCFun>
    <!-- npc_c0_xml · 场景 38 -->
