  <Task id="138" label="研究报告">
    <!-- npcfun_g_xml · 场景 35 -->
    <NPCFun sceneID="35" label="巨石疑阵" icon="-1" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰"><![CDATA[{name}]]>……我的研究报告……被偷了……</Dialog>
          <Button label="报告再写不就得了？" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰">这，没有那么简单……你可知道，我除了致力于研究草系的宠物，我还花费了了大量的时间，去研究草原上的巨石像。</Dialog>
          <Button label="哪里有巨石像啊？" nextID="-1" close="true">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="asWindow" src="task/138/138_0" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_3"/>
        </Default>
      </Script>
      <Script label="index_0_3" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰">我们表面上看到的巨石像，其实就像冰山的一角。更多的石像，其实藏在了广袤的草原下面。而且……他们是活着的……</Dialog>
          <Button label="活着？！" nextID="-1" close="false">
            <Goto value="index_0_4"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_4" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰">对，他们活着，是为了封印一条未知的龙。</Dialog>
          <Button label="什么龙？" nextID="-1" close="true">
            <Goto value="index_0_5"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_5" type="asWindow" src="task/138/138_1" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_6"/>
        </Default>
      </Script>
      <Script label="index_0_6" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰">这条黑龙的能力，不是一般人能够驾驭的。他拥有的魔法潜能不可估量——但，所有控制时间和空间的魔法，都是禁忌。</Dialog>
          <Dialog npcID="107300" npcName="罗兰">不过我相信，一直研究永生魔法的恩佐，对拥有此魔法的未知之龙，非常有兴趣。</Dialog>
          <Button label="报告是他偷的！" nextID="-1" close="false">
            <Goto value="index_0_7"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_7" type="dialog">
        <Page id="0">
          <Dialog npcID="107300" npcName="罗兰">我怕，接下来，恩佐要对这些巨石像下手了。<![CDATA[{name}]]>，你愿意协助我一臂之力，到草原走一趟吗？</Dialog>
          <Button label="当然愿意！" nextID="-1" close="true">
            <Goto value="index_0_8"/>
          </Button>
          <Button label="我再想想……" nextID="-1" close="true">
            <End/>
          </Button>	
        </Page>
      </Script>
      <Click label="index_0_8" event="onTaskCall2" params="1|138"/>
    </Click>
    </NPCFun>
