  <Task id="1078" label="不翼而飞的雕塑画册">
    <!-- npcfun_g_xml · 场景 6 -->
    <NPCFun sceneID="6" label="雕塑家的时间" icon="-1" close="false">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬"><![CDATA[{name}]]>，你听说过艾德曼么？</Dialog>
          <Button label="不知道……" nextID="-1">
            <Goto value="index_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_1" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">艾德曼曾是洛克王国伟大的雕塑家。他写过的草稿和画过的草图，都放在一本叫做《雕刻时光》的书里……</Dialog>
          <Button label="现在这本书丢了，对么？" nextID="-1">
            <Goto value="index_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_2" type="dialog">
        <Page id="0">
          <Dialog npcID="100100" npcName="格里芬">恩……看来你已经有所耳闻了……那些丢失的残页上面，有他的灵魂碎片，所以请你一定要帮我把那些残页找回来。</Dialog>
          <Button label="定不负所托！" nextID="-1" close="true">
            <Goto value="index_3"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_3" event="onTaskCall2" params="1|1078"/>
    </Click>
    </NPCFun>
