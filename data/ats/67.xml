  <Task id="116" label="麋鹿困扰">
    <!-- npcfun_lslt_xml · 场景 13 -->
    <NPCFun sceneID="13" label="麋鹿困扰" icon="-1" close="false">
    		<Click event="onRunScript">
    			<Script label="default" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101000" npcName="兰斯洛"><![CDATA[我又闻到了阴谋的味道……{name}，你知道吗，我收到了王国居民的举报，大量的麋鹿失踪了。]]></Dialog>
                      <Dialog npcID="101000" npcName="兰斯洛"><![CDATA[我怀疑是有人打起传说中麋鹿的主意，进而波及其它宠物麋鹿。]]></Dialog>
    					<Button label="传说中的麋鹿？" nextID="-1" close="true">
    						<Goto value="movie1"/>
    					</Button>
    				</Page>
    			</Script>
    		   <Script label="movie1" type="asWindow" src="task/116/aboutDeer" winPos="0|0" name="传说中的麋鹿">
    					<Case value="0"><Goto value="dialog_2"/></Case>
    			</Script>
    			<Script label="dialog_2" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101000" npcName="兰斯洛">每年的圣诞节，圣诞老人都会和麋鹿一起出现，给乖巧的小朋友派发礼物。</Dialog>
    					<Button label="它失踪了，礼物不就泡汤了吗！" nextID="-1">
    						<Goto value="dialog_3"/>
    					</Button>
    				</Page>
    			</Script>
    		    <Script label="dialog_3" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101000" npcName="兰斯洛">的确是这样子，所以为了各位小洛克，骑士团必须马上找出它来。</Dialog>
    					<Button label="我来帮忙！" nextID="-1">
    						<Goto value="dialog_4"/>
    					</Button>
    				</Page>
    			</Script>
              <Script label="dialog_4" type="dialog">
    				<Page id="0">
    					<Dialog npcID="101000" npcName="兰斯洛">很好，勇敢的小洛克。第一步，必须去麋鹿们失踪的特鲁米小径进行侦查，看是否有蛛丝马迹。</Dialog>
    					<Button label="现在就去！" nextID="-1" close="true">
    						<Goto value="submit"/>
    					</Button>
    				</Page>
    			</Script>
    			<Click label="submit" event="onTaskCall2" params="1|116"/>
    		</Click>
    	</NPCFun>
    <!-- npc_hyr_xml · 场景 58 -->
    <Npc sceneID="58" type="1" npcID="135900" position="747|358">
