    				        <Default><End/></Default>
    	              </Script>
                     <Click event="NULL" fire="true" label="submit"/>
    		   </Click>
    	</Npc>
    <!-- npc_hyr3_xml · 场景 58 -->
    <Npc sceneID="58" type="1" npcID="136100" position="747|358">
    			 <View type="0" src="136100.swf" atLayerID="2" lazyLoad="true" hasClick="false"/>
    			 <Create>
    			   <ViewEvent type="byySuccess">
    				 <Click event="onRunScript">
    					 <Script label="default" type="dialog">
    							<Page>
    								<Dialog npcID="136100" npcName="麋鹿">谢谢你，小洛克，呜呜呜，我好怕……</Dialog>
    								<Button label="唉……他们为什么要抓你呀？">
    									<Goto value="dialog_1"/>
    								</Button>
    							</Page>
    					  </Script>
                        <Script label="dialog_1" type="dialog">
    							<Page>
    								<Dialog npcID="136100" npcName="麋鹿">因为他们找不到七彩鹿，只好一只只抓，以为这样就能够找到七彩鹿了。</Dialog>
                                <Dialog npcID="136100" npcName="麋鹿">七彩鹿是我们之中唯一的一只，拥有非常神奇的能力的麋鹿。</Dialog>
                                <Button label="是什么？">
    									<Goto value="dialog_2"/>
    								</Button>
    							</Page>
    					  </Script>
                        <Script label="dialog_2" type="dialog">
    							<Page>
    								<Dialog npcID="136100" npcName="麋鹿">每当到圣诞节快来临的时候，如果这个小洛克主人是个听话的好孩子，宠物们就会将主人写了礼物愿望的袜子拿到雪山山顶……</Dialog>
                                <Button label="然后呢？" close="true">
    									<Goto value="movie1"/>
    								</Button>
    							</Page>
    					   </Script>
                         <Script label="movie1" type="asWindow" src="task/116/colorDeer1" winPos="0|0" name="雪中拿袜子">
    						    <Case value="0"><Goto value="dialog_3"/></Case>
    					   </Script>
                         <Script label="dialog_3" type="dialog">
    							<Page>
    								<Dialog npcID="136100" npcName="麋鹿">但是每实现一个愿望，麋鹿的犄角就会短一截，直到第二年圣诞来临才会恢复。</Dialog>
                                <Button label="这样子啊……" close="true">
    									<Goto value="movie2"/>
    								</Button>
    							</Page>
    					   </Script>
                         <Script label="movie2" type="asWindow" src="task/116/colorDeer2" winPos="0|0" name="雪中发礼物">
    						    <Case value="0"><Goto value="submit"/></Case>
    					   </Script>
    					   <Click event="NULL" fire="true" label="submit"/>
    					</Click>
    			   </ViewEvent>
    			</Create>
    		</Npc>
    <!-- npc_ml_xml · 场景 58 -->
    <Npc sceneID="58" type="1" npcID="136200" position="747|358">
    		 <View type="0" src="136200.swf" atLayerID="2" lazyLoad="true" hasClick="true"/>
    		   <Click event="onRunScript">
    				 <Script label="default" type="dialog">
    						<Page>
    							<Dialog npcID="136200" npcName="麋鹿">这就是我们称之为愿望术的能力哦。那些穿黑衣服的那么猖狂，七彩鹿肯定会被他们抓去了。</Dialog>
    							<Button label="你觉得我应该到哪里去找它？">
    							<Goto value="dialog_2"/>
    							</Button>
    						</Page>
    				 </Script>
                   <Script label="dialog_2" type="dialog">
    				      <Page id="0">
    					      <Dialog npcID="136200" npcName="麋鹿">（麋鹿想了想）</Dialog>
                            <Dialog npcID="136200" npcName="麋鹿">……嗯，对了！七彩鹿会腾云术！为了躲避黑衣服的，它肯定会飞到天空去！你可以去天空城看看哦！我也很担心它……</Dialog>
    					      <Button label="谢谢你！我现在就去！" close="true">
    						      <Goto value="submit"/>
    					      </Button>
    				       </Page>
    			     </Script>
                   <Click label="submit" event="onTaskCall2" params="2|116"/>
    		   </Click>
    	</Npc>
  </Task>
  <Task id="117" label="救援线索">
