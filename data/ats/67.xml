    					</Button>
    				</Page>
    			</Script>
              <Script label="dialog_5" type="dialog">
    				<Page id="0">
    					<Dialog npcID="117200" npcName="威尔伯.莱特">找博得啊！他专门研究变身，让他把你变成麋鹿不就可以了！</Dialog>
    					<Button label="嗯……我马上找博得！" nextID="-1" close="true">
    						<Goto value="submit"/>
    					</Button>
    				</Page>
    			</Script>
               <Click event="NULL" fire="true" label="submit"/>
    		</Click>
    	</NPCFun>
