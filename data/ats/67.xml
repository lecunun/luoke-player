    		   <Script label="dialog_4" type="dialog">
    				<Page id="0">
    					<Dialog npcID="117200" npcName="威尔伯.莱特">那你就用魔法把自己变成麋鹿，等他们抓你，不就得了！</Dialog>
    					<Button label="说得容易……怎么做啊？" nextID="-1">
