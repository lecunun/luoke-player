    <Npc sceneID="58" type="1" npcID="136000" position="747|358">
    		 <View type="0" src="136000.swf" atLayerID="2" lazyLoad="true" hasClick="true"/>
            <Click event="onRunScript">
                     <Script label="default" type="dialog">
    						<Page>
    							<Dialog npcID="136000" npcName="黑衣人">只要麋鹿抓得越多，找到七彩鹿给恩佐巫师的几率就越大。你这小毛头，一边凉快去吧。</Dialog>
    							<Button label="你不会得逞的！" close="true">
                                <Goto value="fight"/>
    							</Button>
    						</Page>
    					</Script>
                      <Script label="fight" type="switch" invoke="combat" args="2|136000|黑衣人">
