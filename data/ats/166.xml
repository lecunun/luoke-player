  <Task id="2018" label="机智的法比亚">
    <!-- npc_p_xml · 场景 158 -->
    <Npc sceneID="158" type="1" npcID="197700" position="492|369">
    <View type="0" src="197700.swf" atLayerID="2" hasClick="false"/>
    <Create>	
    <ViewEvent type="GotIt0_2018_197700">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="197600" npcName="奥多">法比亚！你怎么了？这群人是谁？</Dialog>
          <Dialog npcID="197700" npcName="法比亚">我也不知道！我看到他们在这里鬼鬼祟祟，还想用宠物来献祭，我一定要阻止他们！你来的正好，快来帮我！</Dialog>
          <Dialog npcID="197600" npcName="奥多">哇呀呀！看我的！喵喵！喵喵~</Dialog>
          <Button label="……" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="197600" npcName="奥多">呀，咕噜球放家里了。</Dialog>
          <Button label="让我来吧！" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="switch" invoke="combat" args="2|197700|武使徒">
        <Case value="2">
          <Goto value="index_0_4"/>
        </Case>
        <Default>
          <End/>
        </Default>
      </Script>
      <Click label="index_0_4" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state0_2018_197700"/>
    </Click>
    </ViewEvent>
    <ViewEvent type="GotIt1_2018_197700">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="197700" npcName="法比亚">我们快来破坏这些魔法阵，放掉这些宠物。击碎这些石柱就可以了！</Dialog>
          <Button label="好！" nextID="-1" close="true">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Click label="index_0_1" event="onSceneCMDCall" cmd="2" type="sceneEvent" params="state1_2018_197700"/>
    </Click>
    </ViewEvent>
    <ViewEvent type="GotIt2_2018_197700">
    <Click event="onRunScript">
      <Script label="default" type="dialog">
        <Page id="0">
          <Dialog npcID="197600" npcName="奥多">太好了，我们又做了一件大好事，回去可以写到日记里面呢！对了，法比亚，你见到过八大徽章候任者了吗？他们可能身处险境，我们在找他们！</Dialog>
          <Dialog npcID="197700" npcName="法比亚">什么？他们失踪了吗？</Dialog>
          <Button label="将事情告诉了法比亚" nextID="-1" close="false">
            <Goto value="index_0_1"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_1" type="dialog">
        <Page id="0">
          <Dialog npcID="197700" npcName="法比亚">时间和空间的魔力……巨石阵……我们现在破坏了巨石阵的阴谋，可是只见到被关押的宠物，却没有见到他们。看来，我们还有一个地方要去。</Dialog>
          <Button label="哪里？" nextID="-1" close="false">
            <Goto value="index_0_2"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_2" type="dialog">
        <Page id="0">
          <Dialog npcID="197700" npcName="法比亚">时间和空间的魔力所在地，幽暗空间！</Dialog>
          <Button label="出发吧！" nextID="-1" close="true">
            <Goto value="index_0_3"/>
          </Button>
        </Page>
      </Script>
      <Script label="index_0_3" type="asWindow" src="task/2018/2018_0" winPos="0|0" name="">
        <Default>
          <Goto value="index_0_4"/>
        </Default>
      </Script>
      <Click label="index_0_4" event="onTaskCall2" params="2|2018"/>
    </Click>
    </ViewEvent>
